<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data noupdate="1">
    <record id="email_template_intern_approaching_hours" model="mail.template">
      <field name="name">Intern Approaching Contracted Hours</field>
      <field name="model_id" ref="hr.model_hr_employee"/>
      <field name="subject">⏳ Intern {{ object.name }} is Approaching Contracted Hours</field>
      <field name="email_from">{{ (user.email_formatted or '') }}</field>
      <field name="email_to">{{ object.parent_id.work_email or '' }}</field>
      <field name="email_cc">{{ object.hr_contact_id.work_email or '' }}</field>
      <field name="auto_delete" eval="False"/>
      <field name="body_html"><![CDATA[
<div style="font-family: Arial, sans-serif; max-width: 600px; margin: auto; border: 1px solid #e0e0e0; border-radius: 8px; overflow: hidden;">
  <div style="background-color: #f59e0b; padding: 20px 30px;">
    <h2 style="color: white; margin: 0;">⏳ Intern Approaching Contracted Hours</h2>
  </div>
  <div style="padding: 30px;">
    <p>Dear HR / Supervisor,</p>
    <p>Intern <strong><t t-out="object.name"/></strong> is approaching their contracted hours limit and will complete their internship soon.</p>
    <table style="width:100%; border-collapse:collapse; margin:20px 0;">
      <tr style="background:#f5f5f5;">
        <td style="padding:10px; border:1px solid #ddd;"><strong>Intern</strong></td>
        <td style="padding:10px; border:1px solid #ddd;"><t t-out="object.name"/></td>
      </tr>
      <tr>
        <td style="padding:10px; border:1px solid #ddd;"><strong>Department</strong></td>
        <td style="padding:10px; border:1px solid #ddd;"><t t-out="object.department_id.name or 'N/A'"/></td>
      </tr>
      <tr style="background:#f5f5f5;">
        <td style="padding:10px; border:1px solid #ddd;"><strong>Hours Rendered</strong></td>
        <td style="padding:10px; border:1px solid #ddd;"><t t-out="'%.2f' % (object.hours_rendered or 0.0)"/></td>
      </tr>
      <tr>
        <td style="padding:10px; border:1px solid #ddd;"><strong>Contracted Hours</strong></td>
        <td style="padding:10px; border:1px solid #ddd;"><t t-out="'%.2f' % (object.contracted_hours or 0.0)"/></td>
      </tr>
      <tr style="background:#fff8e1;">
        <td style="padding:10px; border:1px solid #ddd;"><strong>Hours Remaining</strong></td>
        <td style="padding:10px; border:1px solid #ddd; color:#f59e0b;">
          <strong><t t-out="'%.2f' % max(0.0, (object.contracted_hours or 0.0) - (object.hours_rendered or 0.0))"/> hours</strong>
        </td>
      </tr>
      <tr>
        <td style="padding:10px; border:1px solid #ddd;"><strong>Average Score</strong></td>
        <td style="padding:10px; border:1px solid #ddd;"><t t-out="'%.2f' % (object.average_score or 0.0)"/> / 5.0</td>
      </tr>
    </table>
    <p>Please begin preparing the necessary documentation and advise the intern on next steps (extension, completion certificate, conversion to employment, etc.).</p>
    <p style="margin-top:30px; color:#888; font-size:12px;">This is an automated message from the FAMTECH Intern Dashboard.</p>
  </div>
</div>
      ]]></field>
    </record>
  </data>
</odoo>