<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data noupdate="1">
    <record id="email_template_intern_low_performance" model="mail.template">
      <field name="name">Intern Low Performance Alert</field>
      <field name="model_id" ref="hr.model_hr_employee"/>
      <field name="subject">⚠️ Performance Alert: {{ object.name }} (Score: {{ '%.2f' % (object.average_score or 0.0) }})</field>
      <field name="email_from">{{ (user.email_formatted or '') }}</field>
      <field name="email_to">{{ object.parent_id.work_email or '' }}</field>
      <field name="email_cc">{{ object.hr_contact_id.work_email or '' }}</field>
      <field name="body_html"><![CDATA[
<div style="font-family: Arial, sans-serif; max-width: 600px; margin: auto; border: 1px solid #e0e0e0; border-radius: 8px; overflow: hidden;">
  <div style="background-color: #e53935; padding: 20px 30px;">
    <h2 style="color: white; margin: 0;">⚠️ Intern Performance Alert</h2>
  </div>
  <div style="padding: 30px;">
    <p>Dear HR / Supervisor,</p>
    <p>Intern <strong><t t-out="object.name"/></strong> has fallen below the minimum performance threshold and requires immediate attention.</p>
    <table style="width:100%; border-collapse:collapse; margin:20px 0;">
      <tr style="background:#f5f5f5;">
        <td style="padding:10px; border:1px solid #ddd;"><strong>Intern</strong></td>
        <td style="padding:10px; border:1px solid #ddd;"><t t-out="object.name"/></td>
      </tr>
      <tr>
        <td style="padding:10px; border:1px solid #ddd;"><strong>Department</strong></td>
        <td style="padding:10px; border:1px solid #ddd;"><t t-out="object.department_id.name or 'N/A'"/></td>
      </tr>
      <tr style="background:#fff3f3;">
        <td style="padding:10px; border:1px solid #ddd;"><strong>Average Score</strong></td>
        <td style="padding:10px; border:1px solid #ddd; color:#e53935;">
          <strong><t t-out="'%.2f' % (object.average_score or 0.0)"/> / 5.0</strong>
        </td>
      </tr>
      <tr>
        <td style="padding:10px; border:1px solid #ddd;"><strong>Timeliness</strong></td>
        <td style="padding:10px; border:1px solid #ddd;"><t t-out="'%.2f' % (object.timeliness_score or 0.0)"/></td>
      </tr>
      <tr style="background:#f5f5f5;">
        <td style="padding:10px; border:1px solid #ddd;"><strong>Punctuality</strong></td>
        <td style="padding:10px; border:1px solid #ddd;"><t t-out="'%.2f' % (object.punctuality_score or 0.0)"/></td>
      </tr>
      <tr>
        <td style="padding:10px; border:1px solid #ddd;"><strong>Quality</strong></td>
        <td style="padding:10px; border:1px solid #ddd;"><t t-out="'%.2f' % (object.quality_score or 0.0)"/></td>
      </tr>
      <tr style="background:#f5f5f5;">
        <td style="padding:10px; border:1px solid #ddd;"><strong>Responsiveness</strong></td>
        <td style="padding:10px; border:1px solid #ddd;"><t t-out="'%.2f' % (object.responsiveness_score or 0.0)"/></td>
      </tr>
      <tr>
        <td style="padding:10px; border:1px solid #ddd;"><strong>Accuracy</strong></td>
        <td style="padding:10px; border:1px solid #ddd;"><t t-out="'%.2f' % (object.accuracy_score or 0.0)"/></td>
      </tr>
      <tr style="background:#f5f5f5;">
        <td style="padding:10px; border:1px solid #ddd;"><strong>Hours Rendered</strong></td>
        <td style="padding:10px; border:1px solid #ddd;">
          <t t-out="'%.2f' % (object.hours_rendered or 0.0)"/> / <t t-out="'%.2f' % (object.contracted_hours or 0.0)"/>
        </td>
      </tr>
    </table>
    <p><strong>Recommended Action:</strong> Please schedule a performance counseling session with this intern as soon as possible.</p>
    <p style="margin-top:30px; color:#888; font-size:12px;">This is an automated message from the FAMTECH Intern Dashboard.</p>
  </div>
</div>
      ]]></field>
    </record>
  </data>
</odoo>