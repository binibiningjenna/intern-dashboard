<odoo>
  <data noupdate="1">
    <record id="cron_compute_intern_metrics" model="ir.cron">
      <field name="name">Compute Intern Metrics</field>
      <field name="model_id" ref="famtech_intern_dashboard.model_intern_metric_compute"/>
      <field name="state">code</field>
      <field name="code">model.compute_all_interns_metrics(); model.cleanup_old_meeting_attendance()</field>
      <field name="interval_type">hours</field>
      <field name="interval_number">12</field>
      <field name="user_id" ref="base.user_root"/>
