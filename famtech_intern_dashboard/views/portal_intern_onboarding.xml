<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- ============================================================
       TEMPLATE 1: Inject "Onboarding Status" card into portal home
       ============================================================ -->
  <template id="portal_intern_onboarding_link" inherit_id="portal.portal_my_home" name="Intern Onboarding Link">
    <xpath expr="//div[@id='portal_client_category']" position="inside">
      <t t-if="request.env.user.employee_id and request.env.user.employee_id.is_intern">
        <div class="o_portal_index_card col-md-6 order-2">
          <a href="/onboarding" title="Onboarding Status"
            class="d-flex gap-2 gap-md-3 py-3 pe-2 px-md-3 h-100 rounded text-decoration-none bg-100">
            <div class="o_portal_icon d-block align-self-start">
              <img src="/project/static/src/img/tasks.svg" loading="lazy" style=""/>
            </div>
            <div class="">
              <div class="mt-0 mb-1 fs-5 fw-normal lh-1 d-flex gap-2">
                <span>Intern Dashboard</span>
              </div>
              <div class="opacity-75">
                View your progress
              </div>
            </div>
          </a>
        </div>
      </t>
    </xpath>
  </template>

  <!-- ============================================================
       TEMPLATE 2: Standalone onboarding page at /my/intern/onboarding
       ============================================================ -->
  <template id="portal_intern_onboarding_page" name="Intern Onboarding">
    <t t-call="portal.portal_layout">
      <t t-if="employee and employee.is_intern">

        <!-- SECTION 1: ONBOARDING CHECKLIST (self-update form) -->
        <section class="intern-onboarding mb-5">
          <div class="container">
            <h2 class="mb-4">Onboarding Plan</h2>
            <div class="row">
              <div class="col-lg-8">

                <!-- Wrap steps in a POST form so interns can self-update -->
                <form action="/my/intern/onboarding/update" method="POST">
                  <!-- CSRF token required by Odoo for POST routes -->
                  <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                  <div class="card mb-4">
                    <div class="card-body">
                      <h5 class="card-title">Complete Your Onboarding Steps</h5>
                      <p class="text-muted small mb-3">Check each step once you have completed it, then click <strong>Save Progress</strong>.</p>

                      <ul class="list-group list-group-flush">

                        <!-- Step 1 -->
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                          <div class="d-flex align-items-center gap-3">
                            <input type="checkbox"
                                   class="form-check-input me-2"
                                   name="handbook_reviewed"
                                   value="1"
                                   t-att-checked="'checked' if employee.handbook_reviewed else None"/>
                            <span>
                              <strong>Step 1:</strong> Read Intern Handbook
                              <t t-if="employee.handbook_reviewed">
                                <span class="badge bg-success ms-2">Completed</span>
                              </t>
                              <t t-else="">
                                <span class="badge bg-warning ms-2">Pending</span>
                              </t>
                            </span>
                          </div>
                          <a href="/my/intern/handbook/download" class="btn btn-sm btn-outline-primary">Intern Handbook</a>
                        </li>

                        <!-- Step 2 -->
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                          <div class="d-flex align-items-center gap-3">
                            <input type="checkbox"
                                   class="form-check-input me-2"
                                   name="orientation_completed"
                                   value="1"
                                   t-att-checked="'checked' if employee.orientation_completed else None"/>
                            <span>
                              <strong>Step 2:</strong> Attend Orientation Session
                              <t t-if="employee.orientation_completed">
                                <span class="badge bg-success ms-2">Completed</span>
                              </t>
                              <t t-else="">
                                <span class="badge bg-warning ms-2">Pending</span>
                              </t>
                            </span>
                          </div>
                          <!-- portal_intern_onboarding.xml — Step 2 button -->
                          <a href="/my/intern/calendar" class="btn btn-sm btn-outline-primary">View Calendar</a>
                        </li>

                        <!-- Step 3 -->
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                          <div class="d-flex align-items-center gap-3">
                            <input type="checkbox"
                                   class="form-check-input me-2"
                                   name="odoo_access_granted"
                                   value="1"
                                   t-att-checked="'checked' if employee.odoo_access_granted else None"/>
                            <span>
                              <strong>Step 3:</strong> Set up Odoo Access (Complete Profile)
                              <t t-if="employee.odoo_access_granted">
                                <span class="badge bg-success ms-2">Completed</span>
                              </t>
                              <t t-else="">
                                <span class="badge bg-warning ms-2">Pending</span>
                              </t>
                            </span>
                          </div>
                          <a href="/my/account" class="btn btn-sm btn-outline-primary">Edit Profile</a>
                        </li>

                        <!-- Step 4 -->
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                          <div class="d-flex align-items-center gap-3">
                            <input type="checkbox"
                                   class="form-check-input me-2"
                                   name="first_task_assigned"
                                   value="1"
                                   t-att-checked="'checked' if employee.first_task_assigned else None"/>
                            <span>
                              <strong>Step 4:</strong> Complete First Assigned Task
                              <t t-if="employee.first_task_assigned">
                                <span class="badge bg-success ms-2">Completed</span>
                              </t>
                              <t t-else="">
                                <span class="badge bg-warning ms-2">Pending</span>
                              </t>
                            </span>
                          </div>
                          <a href="/my/tasks" class="btn btn-sm btn-outline-primary">View Tasks</a>
                        </li>

                      </ul>

                      <!-- Save button -->
                      <div class="mt-3">
                        <button type="submit" class="btn btn-primary">Save Progress</button>
                      </div>

                    </div>
                  </div>
                </form>
              </div>

              <!-- Progress Summary Sidebar -->
              <div class="col-lg-4">
                <div class="card bg-light">
                  <div class="card-body">
                    <h5 class="card-title">Progress Summary</h5>
                    <p class="text-muted small">Track your onboarding progress</p>
                    <div class="progress mb-3" role="progressbar">
                      <div class="progress-bar" t-attf-style="width: #{progress}%">
                        <t t-out="progress"/>%
                      </div>
                    </div>
                    <small class="text-muted">
                      <strong><t t-out="progress // 25"/></strong> of 4 steps completed
                    </small>
                  </div>
                </div>
              </div>

            </div>
          </div>
        </section>

        <!-- SECTION 2: METRICS DASHBOARD -->
        <section class="intern-metrics mt-5">
          <div class="container">
            <h2 class="mb-4">Your Performance Metrics</h2>
            <div class="row">

              <!-- Hours Worked -->
              <div class="col-md-6 mb-4">
                <div class="card">
                  <div class="card-body">
                    <h5 class="card-title">Hours Worked</h5>
                    <div class="display-6">
                      <t t-out="'%.2f' % (employee.hours_rendered or 0)"/>
                      <small class="text-muted fs-6">/ <t t-out="'%.2f' % (employee.contracted_hours or 0)"/> hours</small>
                    </div>
                    <p class="text-muted small mt-2">
                      <t t-if="employee.contracted_hours and employee.hours_rendered">
                        <t t-set="hours_remaining" t-value="employee.contracted_hours - employee.hours_rendered"/>
                        <t t-if="hours_remaining > 0">
                          <strong><t t-out="'%.2f' % hours_remaining"/> hours remaining</strong>
                        </t>
                        <t t-else="">
                          <span class="badge bg-success">Goal Reached!</span>
                        </t>
                      </t>
                    </p>
                    <t t-set="hours_pct" t-value="min(int((employee.hours_rendered / employee.contracted_hours * 100) if employee.contracted_hours else 0), 100)"/>
                    <div class="progress mt-3" role="progressbar">
                      <div class="progress-bar bg-info" t-attf-style="width: #{hours_pct}%">
                        <t t-out="hours_pct"/>%
                      </div>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Average Score -->
              <div class="col-md-6 mb-4">
                <div class="card">
                  <div class="card-body">
                    <h5 class="card-title">Average Performance Score</h5>
                    <div class="display-6">
                      <t t-out="employee.average_score or 0"/>
                      <small class="text-muted fs-6">/ 5.0</small>
                    </div>
                    <p class="text-muted small mt-2">
                      <t t-if="employee.average_score">
                        <t t-set="score" t-value="employee.average_score"/>
                        <t t-if="score >= 4.5">
                          <span class="badge bg-success">Excellent</span>
                        </t>
                        <t t-elif="score >= 3.5">
                          <span class="badge bg-info">Good</span>
                        </t>
                        <t t-elif="score >= 2.5">
                          <span class="badge bg-warning">Fair</span>
                        </t>
                        <t t-else="">
                          <span class="badge bg-danger">Needs Improvement</span>
                        </t>
                      </t>
                    </p>
                    <t t-set="score_pct" t-value="int((employee.average_score / 5.0 * 100) if employee.average_score else 0)"/>
                    <div class="progress mt-3" role="progressbar">
                      <div class="progress-bar bg-success" t-attf-style="width: #{score_pct}%">
                        <t t-out="score_pct"/>%
                      </div>
                    </div>
                  </div>
                </div>
              </div>

            </div>

            <!-- Intern Details Table -->
            <div class="row mt-2">
              <div class="col-lg-12">
                <div class="card">
                  <div class="card-body">
                    <h5 class="card-title">Intern Details</h5>
                    <table class="table table-sm">
                      <tbody>
                        <tr>
                          <td><strong>Supervisor:</strong></td>
                          <td><t t-out="employee.parent_id.name if employee.parent_id else 'Not Assigned'"/></td>
                        </tr>
                        <tr>
                          <td><strong>Department:</strong></td>
                          <td><t t-out="employee.department_id.name if employee.department_id else 'Not Assigned'"/></td>
                        </tr>
                        <tr>
                          <td><strong>Last Updated:</strong></td>
                          <td><t t-out="employee.write_date.strftime('%Y-%m-%d %H:%M') if employee.write_date else 'N/A'"/></td>
                        </tr>
                      </tbody>
                    </table>
                  </div>
                </div>
              </div>
            </div>

          </div>
        </section>

      </t>
    </t>
  </template>

  <!-- ============================================================
      TEMPLATE 3: Portal calendar page at /my/intern/calendar
      ============================================================ -->
  <template id="portal_intern_calendar_page" name="Intern Calendar">
      <t t-call="famtech_intern_dashboard.intern_navbar"/>
      <head>
          <title>Intern Calendar</title>
          <meta charset="utf-8"/>
          <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
          <link rel="preconnect" href="https://fonts.googleapis.com"/>
          <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="crossorigin"/>
          <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&amp;display=swap" rel="stylesheet"/>
          <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet"/>
          <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"/>
          <link href="/famtech_intern_dashboard/static/src/website/css/global.css" rel="stylesheet"/>
          <link href="/famtech_intern_dashboard/static/src/website/css/onboarding.css" rel="stylesheet"/>
          <link href="https://cdn.jsdelivr.net/npm/aos@2.3.4/dist/aos.css" rel="stylesheet"/>
      </head>

      <div class="w-100 main-bg" style="min-height: 100vh; font-family: 'Poppins', sans-serif; background-color: var(--color-gray-100);">
        <div class="container py-5">
            <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center mb-2"
                data-aos="fade-down"
                data-aos-duration="700">
                <div>
                    <h4 class="mb-1 fw-bold" style="text-transform: uppercase;">
                        Meeting Schedule
                    </h4>
                    <p class="text-muted mb-0" style="font-size: 0.9rem;">
                        View and manage your scheduled meetings, attendance, and upcoming session.
                    </p>
                    <p class="text-muted mb-0 mt-2" style="font-size: 0.85rem;">
                        Only meetings tagged <span class="fw-semibold"><t t-out="onboarding_meeting_tag"/></span> count toward onboarding Step 2.
                    </p>
                </div>
                <a href="/onboarding"
                class="btn btn-primary d-flex align-items-center gap-2 mt-2 md-mt-0">
                    <i class="bi bi-arrow-left me-2"></i>
                    Back to Onboarding
                </a>
            </div>

            <hr class="brand-divider mb-4" data-aos="fade-in" data-aos-duration="1000" data-aos-delay="200" />

            <div class="row g-2 mb-4 align-items-center">
                <!-- Search -->
                <div class="col-12 col-lg-5 col-xl-6" data-aos="fade-up" data-aos-duration="1000" data-aos-delay="100">
                    <div class="input-group custom-search-group">

                        <span class="input-group-text custom-search-icon">
                            <i class="bi bi-search text-white"></i>
                        </span>

                        <input type="text"
                              id="meetingSearch"
                              class="form-control custom-input"
                              placeholder="Search meeting..." />
                    </div>
                </div>

                <!-- Filter and Sort -->
                <div class="col-12 col-lg-7 col-xl-6">
                    <div class="d-flex gap-2 w-100 justify-content-lg-end">

                        <!-- Event Filter -->
                        <div class="position-relative flex-fill flex-lg-grow-0 select-wrapper" data-aos="fade-up" data-aos-duration="1000" data-aos-delay="100">
                            <i class="bi bi-calendar-event select-icon"></i>
                            <select id="eventFilter"
                                    class="form-select custom-select">
                                <option value="all">All Events</option>
                                <option value="live">Live</option>
                                <option value="upcoming">Upcoming</option>
                                <option value="ended">Ended</option>
                            </select>
                        </div>

                        <!-- Attendance Status Filter -->
                        <div class="position-relative flex-fill flex-lg-grow-0 select-wrapper" data-aos="fade-up" data-aos-duration="1000" data-aos-delay="100">
                            <i class="bi bi-person-check select-icon"></i>
                            <select id="attendanceFilter" class="form-select custom-select">
                                <option value="all">All Status</option>
                                <option value="ontime">On Time</option>
                                <option value="late">Late</option>
                                <option value="very_late">Very Late</option>
                                <option value="absent">Absent</option>
                            </select>
                        </div>

                        <!-- Sort -->
                        <div class="position-relative flex-fill flex-lg-grow-0 select-wrapper" data-aos="fade-up" data-aos-duration="1000" data-aos-delay="100">
                            <i class="bi bi-arrow-down-up select-icon"></i>
                            <select id="dateOrder"
                                    class="form-select custom-select">
                                <option value="asc">Oldest</option>
                                <option value="desc">Newest</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row g-3" id="eventsGrid">
                <t t-if="events">
                    <t t-foreach="events" t-as="e">
                        <t t-set="event" t-value="e['event']"/>
                        <t t-set="attendance_data" t-value="attendance_map.get(event.id)"/>
                        <t t-set="attendance" t-value="attendance_data and attendance_data['record']"/>
                        <t t-set="is_ongoing" t-value="e.get('start') and e.get('stop') and e['start'] &lt;= now and now &lt;= e['stop']"/>
                        <t t-set="is_past" t-value="e.get('stop') and now &gt; e['stop']"/>
                        <t t-set="window_open" t-value="e.get('start') and (e['start'] - relativedelta(minutes=5)) &lt;= now"/>
                        <t t-set="session_error" t-value="session_errors.get(event.id, '')"/>
                        <t t-set="is_onboarding_event" t-value="any((category.name or '').strip().lower() == onboarding_meeting_tag.lower() for category in event.categ_ids)"/>

                        <div class="col-12 col-md-6 col-lg-4 col-xl-3 event-card-wrapper" 
                            data-aos="fade-up" 
                            data-aos-duration="1000"
                            t-attf-data-aos-delay="{{ 50 + (e_index * 100) }}"
                            t-att-data-name="event.name.lower()" 
                            t-att-data-status="'live' if is_ongoing else ('ended' if is_past else 'upcoming')"
                            t-att-data-attendance="attendance.attendance_status if attendance else ('absent' if is_past else 'none')"
                            t-att-data-timestamp="e.get('start').timestamp() if e.get('start') else 0">
                            
                            <div class="card h-100 border shadow-sm d-flex flex-column" style="border-radius: 12px; border-color: var(--color-gray-300) !important;">
                                <div class="px-3 pt-3 pb-2 d-flex justify-content-between align-items-center">
                                    <div class="text-uppercase fw-bold" style="font-size: 0.65rem; letter-spacing: 0.5px; color: var(--color-gray-500);">
                                        <t t-if="is_onboarding_event">Onboarding Details</t>
                                        <t t-else="">Event Details</t>
                                    </div>
                                    <t t-if="is_ongoing">
                                        <span class="badge rounded-2 px-2 py-1" style="background-color: var(--color-navy-100); color: var(--color-navy-700); border: 1px solid var(--color-navy-300); font-size: 0.65rem;">LIVE</span>
                                    </t>
                                    <t t-elif="is_past">
                                        <span class="badge rounded-2 px-2 py-1" style="background-color: var(--color-gray-100); color: var(--color-gray-700); border: 1px solid var(--color-gray-300); font-size: 0.65rem;">ENDED</span>
                                    </t>
                                    <t t-else="">
                                        <span class="badge rounded-2 px-2 py-1" style="background-color: var(--color-gold-100); color: var(--color-gold-900); border: 1px solid var(--color-gold-300); font-size: 0.65rem;">UPCOMING</span>
                                    </t>
                                </div>

                                <div class="card-body px-3 py-0 d-flex flex-column flex-grow-1">
                                    <h6 class="fw-bold mb-2" style="line-height: 1.2; color: var(--color-navy-900);">
                                        <t t-out="event.name"/>
                                    </h6>

                                    <div class="mb-3 p-2 rounded-2" style="background-color: var(--color-white); border-left: 3px solid var(--color-gold-500); box-shadow: inset 0 0 5px rgba(0,0,0,0.02);">
                                        <div class="text-uppercase fw-bold mb-0" style="font-size: 0.65rem; letter-spacing: 0.5px; color: var(--color-gray-500);">Schedule</div>
                                        <div class="small fw-bold" style="color: var(--color-navy-700);">
                                            <t t-if="e.get('start')">
                                                <t t-out="e['start'].strftime('%B %d, %Y')"/>
                                                <div class="fw-normal" style="font-size: 0.80rem; color: var(--color-gray-700);">
                                                    <t t-out="e['start'].strftime('%I:%M %p')"/> – <t t-out="e['stop'].strftime('%I:%M %p')"/>
                                                </div>
                                            </t>
                                        </div>
                                    </div>

                                    <t t-if="session_error">
                                        <div class="mb-2 small p-2 rounded" style="font-size: 0.7rem; background-color: #FFF5F5; color: #C53030;">
                                            <i class="bi bi-exclamation-triangle me-1"></i><t t-out="session_error"/>
                                        </div>
                                    </t>

                                    <!-- Attendance Status -->
                                    <div class="mt-auto pb-3 d-flex justify-content-between align-items-center gap-2 border-top pt-2">
                                        <div class="d-flex flex-column justify-content-center">
                                            <!-- Present -->
                                            <t t-if="attendance">
                                                <t t-set="status_map" t-value="{
                                                    'ontime': 'On Time',
                                                    'late': 'Late',
                                                    'very_late': 'Very Late'
                                                }"/>
                                                <t t-set="status_color"
                                                  t-value="'var(--color-navy-500)' if attendance.attendance_status == 'ontime' else 'var(--color-gold-500)'"/>
                                                <div class="d-flex align-items-center gap-1">
                                                    <i class="bi bi-check-circle-fill"
                                                      t-att-style="'font-size: 0.8rem; color: ' + status_color"/>
                                                    <span class="fw-bold"
                                                          t-att-style="'font-size: 0.75rem; color: ' + status_color">
                                                        <t t-esc="status_map.get(attendance.attendance_status, 'On Time')"/>
                                                    </span>
                                                    <span style="color: var(--color-gray-400); font-size: 0.7rem;">at</span>
                                                    <t t-if="attendance_data and attendance_data.get('join_time')">
                                                        <span class="small"
                                                              style="font-size: 0.70rem; color: var(--color-gray-500);">
                                                            <t t-out="attendance_data['join_time'].strftime('%I:%M %p')"/>
                                                        </span>
                                                    </t>
                                                </div>
                                            </t>

                                            <!-- Absent -->
                                            <t t-elif="not attendance">
                                                <t t-if="is_past">
                                                    <div class="d-flex align-items-center gap-1">
                                                        <i class="bi bi-x-circle-fill"
                                                          style="font-size: 0.8rem; color: var(--color-gray-500)"></i>

                                                        <span class="fw-bold"
                                                              style="font-size: 0.75rem; color: var(--color-gray-500);">
                                                            Absent
                                                        </span>
                                                    </div>

                                                </t>

                                                <!-- No recorded attendance yet -->
                                                <t t-else="">

                                                    <div class="d-flex align-items-center gap-1">
                                                        <i class="bi bi-clock-fill"
                                                          style="font-size: 0.8rem; color: var(--color-gray-400)"></i>

                                                        <span class="fw-bold"
                                                              style="font-size: 0.75rem; color: var(--color-gray-400);">
                                                            No Record
                                                        </span>
                                                    </div>
                                                </t>
                                            </t>

                                            <!-- Meeting location -->
                                            <t t-if="event.location">
                                                <span class="text-truncate"
                                                      style="font-size: 0.75rem; max-width: 150px; color: var(--color-gray-500);">
                                                    <i class="bi bi-geo-alt me-1"></i>
                                                    <t t-out="event.location"/>
                                                </span>
                                            </t>
                                        </div>

                                        <!-- Control meeting buttons -->
                                        <div class="flex-shrink-0">
                                            <t t-if="event.videocall_location and not attendance and not is_past">
                                                <!-- Show join if no attendance and ongoing meeting -->
                                                <t t-if="window_open or is_ongoing">
                                                    <a t-attf-href="/my/intern/join-call/#{event.id}" target="_blank" 
                                                      class="btn btn-secondary">
                                                        <i class="bi bi-camera-video me-2"></i>Join
                                                    </a>
                                                </t>
                                                <!-- Show standby is the meeting is not yet started -->
                                                <t t-else="">
                                                    <button class="btn btn-secondary opacity-50" disabled="disabled">
                                                        <i class="bi bi-hourglass-split me-2"></i>Standby
                                                    </button>
                                                </t>
                                            </t>
                                            <!-- Show rejoin if already attended -->
                                            <t t-elif="event.videocall_location and attendance and not is_past">
                                                <a t-att-href="event.videocall_location" target="_blank" 
                                                  class="btn btn-secondary">
                                                    <i class="bi bi-arrow-repeat me-2"></i>Rejoin
                                                </a>
                                            </t>
                                            <!-- Log attendance if no video call link -->
                                            <t t-elif="not event.videocall_location and not attendance and (is_ongoing or window_open) and not is_past">
                                                <a t-attf-href="/my/intern/log-attendance/#{event.id}" 
                                                  class="btn btn-secondary">
                                                    <i class="bi bi-pencil-square me-2"></i>Log
                                                </a>
                                            </t>
                                        </div>
