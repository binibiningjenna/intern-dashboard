<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- ============================================================
       TEMPLATE 1: Inject "Onboarding Status" card into portal home
       ============================================================ -->
  <template id="portal_intern_onboarding_link" inherit_id="portal.portal_my_home" name="Intern Onboarding Link">
    <xpath expr="//div[@id='portal_client_category']" position="inside">
      <t t-if="request.env.user.employee_id and request.env.user.employee_id.is_intern">
        <div class="o_portal_index_card col-md-6 order-2">
          <a href="/onboarding" title="Onboarding Status"
            class="d-flex gap-2 gap-md-3 py-3 pe-2 px-md-3 h-100 rounded text-decoration-none bg-100">
            <div class="o_portal_icon d-block align-self-start">
              <img src="/project/static/src/img/tasks.svg" loading="lazy" style=""/>
            </div>
            <div class="">
              <div class="mt-0 mb-1 fs-5 fw-normal lh-1 d-flex gap-2">
                <span>Intern Dashboard</span>
              </div>
              <div class="opacity-75">
                View your progress
              </div>
            </div>
          </a>
        </div>
      </t>
    </xpath>
  </template>

  <!-- ============================================================
       TEMPLATE 2: Standalone onboarding page at /my/intern/onboarding
       ============================================================ -->
  <template id="portal_intern_onboarding_page" name="Intern Onboarding">
    <t t-call="portal.portal_layout">
      <t t-if="employee and employee.is_intern">

        <!-- SECTION 1: ONBOARDING CHECKLIST (self-update form) -->
        <section class="intern-onboarding mb-5">
          <div class="container">
            <h2 class="mb-4">Onboarding Plan</h2>
            <div class="row">
              <div class="col-lg-8">

                <!-- Wrap steps in a POST form so interns can self-update -->
                <form action="/my/intern/onboarding/update" method="POST">
                  <!-- CSRF token required by Odoo for POST routes -->
                  <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                  <div class="card mb-4">
                    <div class="card-body">
                      <h5 class="card-title">Complete Your Onboarding Steps</h5>
                      <p class="text-muted small mb-3">Check each step once you have completed it, then click <strong>Save Progress</strong>.</p>

                      <ul class="list-group list-group-flush">

                        <!-- Step 1 -->
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                          <div class="d-flex align-items-center gap-3">
                            <input type="checkbox"
                                   class="form-check-input me-2"
                                   name="handbook_reviewed"
                                   value="1"
                                   t-att-checked="'checked' if employee.handbook_reviewed else None"/>
                            <span>
                              <strong>Step 1:</strong> Read Intern Handbook
                              <t t-if="employee.handbook_reviewed">
                                <span class="badge bg-success ms-2">Completed</span>
                              </t>
                              <t t-else="">
                                <span class="badge bg-warning ms-2">Pending</span>
                              </t>
                            </span>
                          </div>
                          <a href="/my/intern/handbook/download" class="btn btn-sm btn-outline-primary">Intern Handbook</a>
                        </li>

                        <!-- Step 2 -->
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                          <div class="d-flex align-items-center gap-3">
                            <input type="checkbox"
                                   class="form-check-input me-2"
                                   name="orientation_completed"
                                   value="1"
                                   t-att-checked="'checked' if employee.orientation_completed else None"/>
                            <span>
                              <strong>Step 2:</strong> Attend Orientation Session
                              <t t-if="employee.orientation_completed">
                                <span class="badge bg-success ms-2">Completed</span>
                              </t>
                              <t t-else="">
                                <span class="badge bg-warning ms-2">Pending</span>
                              </t>
                            </span>
                          </div>
                          <!-- portal_intern_onboarding.xml — Step 2 button -->
                          <a href="/my/intern/calendar" class="btn btn-sm btn-outline-primary">View Calendar</a>
                        </li>

                        <!-- Step 3 -->
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                          <div class="d-flex align-items-center gap-3">
                            <input type="checkbox"
                                   class="form-check-input me-2"
                                   name="odoo_access_granted"
                                   value="1"
                                   t-att-checked="'checked' if employee.odoo_access_granted else None"/>
                            <span>
                              <strong>Step 3:</strong> Set up Odoo Access (Complete Profile)
                              <t t-if="employee.odoo_access_granted">
                                <span class="badge bg-success ms-2">Completed</span>
                              </t>
                              <t t-else="">
                                <span class="badge bg-warning ms-2">Pending</span>
                              </t>
                            </span>
                          </div>
                          <a href="/my/account" class="btn btn-sm btn-outline-primary">Edit Profile</a>
                        </li>

                        <!-- Step 4 -->
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                          <div class="d-flex align-items-center gap-3">
                            <input type="checkbox"
                                   class="form-check-input me-2"
                                   name="first_task_assigned"
                                   value="1"
                                   t-att-checked="'checked' if employee.first_task_assigned else None"/>
                            <span>
                              <strong>Step 4:</strong> Complete First Assigned Task
                              <t t-if="employee.first_task_assigned">
                                <span class="badge bg-success ms-2">Completed</span>
                              </t>
                              <t t-else="">
                                <span class="badge bg-warning ms-2">Pending</span>
                              </t>
                            </span>
                          </div>
                          <a href="/my/tasks" class="btn btn-sm btn-outline-primary">View Tasks</a>
                        </li>

                      </ul>

                      <!-- Save button -->
                      <div class="mt-3">
                        <button type="submit" class="btn btn-primary">Save Progress</button>
                      </div>

                    </div>
                  </div>
                </form>
              </div>

              <!-- Progress Summary Sidebar -->
              <div class="col-lg-4">
                <div class="card bg-light">
                  <div class="card-body">
                    <h5 class="card-title">Progress Summary</h5>
                    <p class="text-muted small">Track your onboarding progress</p>
                    <div class="progress mb-3" role="progressbar">
                      <div class="progress-bar" t-attf-style="width: #{progress}%">
                        <t t-out="progress"/>%
                      </div>
                    </div>
                    <small class="text-muted">
                      <strong><t t-out="progress // 25"/></strong> of 4 steps completed
                    </small>
                  </div>
                </div>
              </div>

            </div>
          </div>
        </section>

        <!-- SECTION 2: METRICS DASHBOARD -->
        <section class="intern-metrics mt-5">
          <div class="container">
            <h2 class="mb-4">Your Performance Metrics</h2>
            <div class="row">

              <!-- Hours Worked -->
              <div class="col-md-6 mb-4">
                <div class="card">
                  <div class="card-body">
                    <h5 class="card-title">Hours Worked</h5>
                    <div class="display-6">
                      <t t-out="'%.2f' % (employee.hours_rendered or 0)"/>
                      <small class="text-muted fs-6">/ <t t-out="'%.2f' % (employee.contracted_hours or 0)"/> hours</small>
                    </div>
                    <p class="text-muted small mt-2">
                      <t t-if="employee.contracted_hours and employee.hours_rendered">
                        <t t-set="hours_remaining" t-value="employee.contracted_hours - employee.hours_rendered"/>
                        <t t-if="hours_remaining > 0">
                          <strong><t t-out="'%.2f' % hours_remaining"/> hours remaining</strong>
                        </t>
                        <t t-else="">
                          <span class="badge bg-success">Goal Reached!</span>
                        </t>
                      </t>
                    </p>
                    <t t-set="hours_pct" t-value="min(int((employee.hours_rendered / employee.contracted_hours * 100) if employee.contracted_hours else 0), 100)"/>
                    <div class="progress mt-3" role="progressbar">
                      <div class="progress-bar bg-info" t-attf-style="width: #{hours_pct}%">
                        <t t-out="hours_pct"/>%
                      </div>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Average Score -->
              <div class="col-md-6 mb-4">
                <div class="card">
                  <div class="card-body">
                    <h5 class="card-title">Average Performance Score</h5>
                    <div class="display-6">
                      <t t-out="employee.average_score or 0"/>
                      <small class="text-muted fs-6">/ 5.0</small>
                    </div>
                    <p class="text-muted small mt-2">
                      <t t-if="employee.average_score">
                        <t t-set="score" t-value="employee.average_score"/>
                        <t t-if="score >= 4.5">
                          <span class="badge bg-success">Excellent</span>
                        </t>
                        <t t-elif="score >= 3.5">
                          <span class="badge bg-info">Good</span>
                        </t>
                        <t t-elif="score >= 2.5">
                          <span class="badge bg-warning">Fair</span>
                        </t>
                        <t t-else="">
                          <span class="badge bg-danger">Needs Improvement</span>
                        </t>
                      </t>
                    </p>
                    <t t-set="score_pct" t-value="int((employee.average_score / 5.0 * 100) if employee.average_score else 0)"/>
                    <div class="progress mt-3" role="progressbar">
                      <div class="progress-bar bg-success" t-attf-style="width: #{score_pct}%">
                        <t t-out="score_pct"/>%
                      </div>
                    </div>
                  </div>
                </div>
              </div>

            </div>

            <!-- Intern Details Table -->
            <div class="row mt-2">
              <div class="col-lg-12">
                <div class="card">
                  <div class="card-body">
                    <h5 class="card-title">Intern Details</h5>
                    <table class="table table-sm">
                      <tbody>
                        <tr>
                          <td><strong>Supervisor:</strong></td>
                          <td><t t-out="employee.parent_id.name if employee.parent_id else 'Not Assigned'"/></td>
                        </tr>
                        <tr>
                          <td><strong>Department:</strong></td>
                          <td><t t-out="employee.department_id.name if employee.department_id else 'Not Assigned'"/></td>
                        </tr>
                        <tr>
                          <td><strong>Last Updated:</strong></td>
                          <td><t t-out="employee.write_date.strftime('%Y-%m-%d %H:%M') if employee.write_date else 'N/A'"/></td>
                        </tr>
                      </tbody>
                    </table>
                  </div>
                </div>
              </div>
            </div>

          </div>
        </section>

      </t>
    </t>
  </template>

  <!-- ============================================================
      TEMPLATE 3: Portal calendar page at /my/intern/calendar
      ============================================================ -->
  <template id="portal_intern_calendar_page" name="Intern Calendar">
    <t t-call="famtech_intern_dashboard.intern_navbar"/>
    <head>
      <title>Intern Calendar</title>
      <meta charset="utf-8"/>
      <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
      <link rel="preconnect" href="https://fonts.googleapis.com"/>
      <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="crossorigin"/>
      <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&amp;display=swap" rel="stylesheet"/>
      <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet"/>
      <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"/>
      <link href="/famtech_intern_dashboard/static/src/website/css/global.css" rel="stylesheet"/>
    </head>

      <div class="w-100" style="background: radial-gradient(circle at 50% 0%, var(--color-white) 0%, var(--color-gray-100) 100%); min-height: 100vh; font-family: 'Poppins', sans-serif;">
          <div class="container py-5">

              <!-- Header -->
              <div class="row mb-4">
                  <div class="col-12 d-flex justify-content-between align-items-center flex-wrap gap-2">
                      <div class="d-flex align-items-center gap-2">
                          <i class="bi bi-calendar3" style="color: var(--color-gold-500); font-size: 1.5rem;"></i>
                          <h1 class="fw-bold mb-0">My Orientation &amp; Meetings</h1>
                      </div>
                      <a href="/onboarding" class="btn btn-secondary btn-sm px-3">
                          <i class="bi bi-arrow-left me-1"></i>Back to Onboarding
                      </a>
                  </div>
              </div>

              <!-- Events -->
              <div class="row">
                  <div class="col-12">
                      <t t-if="events">
                          <div class="d-flex flex-column gap-3">
                              <t t-foreach="events" t-as="event">

                                  <!-- Variables for this event -->
                                  <t t-set="attendance" t-value="attendance_map.get(event.id)"/>
                                  <t t-set="has_attended" t-value="bool(attendance)"/>
                                  <t t-set="is_ongoing" t-value="event.start &lt;= now and now &lt;= event.stop"/>
                                  <t t-set="is_upcoming" t-value="now &lt; event.start"/>
                                  <t t-set="is_past" t-value="now > event.stop"/>
                                  <t t-set="window_open" t-value="(event.start - relativedelta(minutes=5)) &lt;= now"/>
                                  <t t-set="session_error" t-value="session_errors.get(event.id, '')"/>

                                  <div class="card">
                                      <div class="card-body">
                                          <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap">

                                              <!-- Event Info -->
                                              <div class="flex-grow-1">
                                                  <div class="d-flex align-items-center gap-2 mb-2">
                                                      <i class="bi bi-calendar-event" style="color: var(--color-gold-500);"></i>
                                                      <h5 class="fw-bold mb-0"><t t-out="event.name"/></h5>
                                                      <!-- Status badge -->
                                                      <t t-if="is_ongoing">
                                                          <span class="badge rounded-pill" style="background-color: var(--color-navy-100); color: var(--color-navy-700);">Live</span>
                                                      </t>
                                                      <t t-elif="is_past">
                                                          <span class="badge rounded-pill" style="background-color: var(--color-gray-100); color: var(--color-gray-500);">Ended</span>
                                                      </t>
                                                      <t t-else="">
                                                          <span class="badge rounded-pill" style="background-color: var(--color-gold-100); color: var(--color-gold-900);">Upcoming</span>
                                                      </t>
                                                  </div>

                                                  <div class="d-flex flex-wrap gap-3 small mb-2" style="color: var(--color-gray-500);">
                                                      <span><i class="bi bi-clock me-1"></i><strong>Start:</strong> <t t-out="event.start.strftime('%B %d, %Y %I:%M %p')"/></span>
                                                      <span><i class="bi bi-clock-history me-1"></i><strong>End:</strong> <t t-out="event.stop.strftime('%B %d, %Y %I:%M %p')"/></span>
                                                      <t t-if="event.location">
                                                          <span><i class="bi bi-geo-alt me-1"></i><t t-out="event.location"/></span>
                                                      </t>
                                                  </div>

                                                  <!-- Attendance status -->
                                                  <t t-if="has_attended">
                                                      <div class="d-flex align-items-center gap-2 small mt-2">
                                                          <i class="bi bi-check-circle-fill" style="color: var(--color-navy-500);"></i>
                                                          <span style="color: var(--color-navy-700);">
                                                              Attendance logged —
                                                              <strong><t t-out="attendance.attendance_status.replace('_', ' ').title()"/></strong>
                                                              at <t t-out="attendance.join_time.strftime('%I:%M %p')"/>
                                                              <t t-if="attendance.minutes_late > 0">
                                                                  (<t t-out="attendance.minutes_late"/> min late)
                                                              </t>
                                                          </span>
                                                      </div>
                                                  </t>

                                                  <!-- Session error (shown after returning from video call) -->
                                                  <t t-if="session_error">
                                                      <div class="small mt-2 p-2 rounded" style="background-color: var(--color-gold-100); color: var(--color-gold-900);">
                                                          <i class="bi bi-exclamation-triangle me-1"></i>
                                                          <t t-out="session_error"/>
                                                      </div>
                                                  </t>

                                                  <t t-if="event.description">
                                                      <p class="mt-2 mb-0 small" style="color: var(--color-gray-500);"><t t-out="event.description"/></p>
                                                  </t>
                                              </div>

                                              <!-- Action buttons -->
                                              <div class="d-flex flex-column align-items-end gap-2 flex-shrink-0">

                                                  <!-- Date badge -->
                                                  <span class="badge rounded-pill px-3 py-2" style="background-color: var(--color-navy-100); color: var(--color-navy-700);">
                                                      <t t-out="event.start.strftime('%b %d')"/>
                                                  </span>

                                                  <t t-if="event.videocall_location and not has_attended and not is_past">
                                                      <!-- Join + Log Attendance (available 5 min before start) -->
                                                      <t t-if="window_open or is_ongoing">
                                                          <a t-attf-href="/my/intern/join-call/#{event.id}"
                                                            class="btn btn-primary btn-sm px-3">
                                                              <i class="bi bi-camera-video me-1"></i>Join &amp; Log Attendance
                                                          </a>
                                                      </t>
                                                      <t t-else="">
                                                          <span class="btn btn-primary btn-sm px-3 disabled" style="opacity: 0.5;">
                                                              <i class="bi bi-camera-video me-1"></i>Join Call
                                                          </span>
                                                          <small class="text-end" style="color: var(--color-gray-500); max-width: 160px;">
                                                              Available 5 min before start
                                                          </small>
                                                      </t>
                                                  </t>

                                                  <t t-elif="event.videocall_location and has_attended">
                                                      <!-- Already attended — still allow rejoining without re-logging -->
                                                      <a t-att-href="event.videocall_location" target="_blank"
                                                        class="btn btn-secondary btn-sm px-3">
                                                          <i class="bi bi-camera-video me-1"></i>Rejoin Call
                                                      </a>
                                                  </t>

                                                  <t t-elif="not event.videocall_location and not has_attended and (is_ongoing or window_open) and not is_past">
                                                      <!-- In-person event — log attendance manually -->
                                                      <a t-attf-href="/my/intern/log-attendance/#{event.id}"
                                                        class="btn btn-primary btn-sm px-3">
                                                          <i class="bi bi-check2-circle me-1"></i>Log Attendance
                                                      </a>
                                                  </t>

                                              </div>
                                          </div>
                                      </div>
                                  </div>
                              </t>
                          </div>
                      </t>

                      <t t-else="">
                          <div class="card">
                              <div class="card-body text-center py-5">
                                  <i class="bi bi-calendar-x" style="font-size: 3rem; color: var(--color-gray-300);"></i>
                                  <p class="mt-3 mb-0" style="color: var(--color-gray-500);">
                                      No orientation or meeting events found for your account.
                                      Please contact HR if you believe this is an error.
                                  </p>
                              </div>
                          </div>
                      </t>
                  </div>
              </div>
          </div>
      </div>
  </template>

</odoo>