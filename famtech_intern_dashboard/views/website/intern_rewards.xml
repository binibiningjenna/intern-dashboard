<odoo>
    <template id="intern_rewards" name="Intern Rewards">
        <t t-call="famtech_intern_dashboard.intern_navbar"/>
        <head>
            <title>Intern Rewards</title>
            <meta charset="utf-8"/>
            <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
            <link rel="preconnect" href="https://fonts.googleapis.com"/>
            <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="crossorigin"/>
            <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&amp;display=swap" rel="stylesheet"/>
            <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet"/>
            <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"/>
            <link href="/famtech_intern_dashboard/static/src/website/css/global.css" rel="stylesheet"/>
            <link href="/famtech_intern_dashboard/static/src/website/css/rewards.css" rel="stylesheet"/>
        </head>

        <div class="intern-rewards-page">
            <div class="w-100 main-bg" style="min-height: 100vh; font-family: 'Poppins', sans-serif;">
                <div class="container py-5">

                    <div>
                            <h4 class="mb-1 fw-bold" style="text-transform: uppercase;">
                                Rewards
                            </h4>
                            <p class="text-muted mb-0" style="font-size: 0.9rem;">
                                Track your achievements, unlock badges, and claim vouchers based on your internship progress and performance.
                            </p>
                        </div>

                    <hr class="brand-divider mb-4"/>

                    <!-- TOP SECTION -->
                    <div class="row g-4 rewards-top-row align-items-stretch">

                        <!-- WEEKLY GAMES WINNER -->
                        <div class="col-xl-4 col-lg-6 d-flex">
                            <div class="reward-highlight-card reward-highlight-card--winner reward-equal-card w-100">
                                <div class="dashboard-header">
                                    <span class="dashboard-title">
                                        <span class="dashboard-icon">
                                            <i class="bi bi-trophy-fill"></i>
                                        </span>
                                        Weekly Games Winner
                                    </span>
                                </div>

                                <div class="reward-highlight-card__body reward-highlight-card__body--winner">
                                    <div class="reward-winner-pill">
                                        <i class="bi bi-calendar-week"></i>
                                        <span t-esc="current_week_label"/>
                                    </div>

                                    <div class="reward-winner-profile">
                                        <div class="reward-winner-photo-wrap">
                                            <div class="reward-winner-photo-frame">
                                                <img t-att-src="weekly_winner_image_url"
                                                     alt="Weekly Winner"
                                                     class="reward-winner-photo"/>
                                            </div>
                                        </div>

                                        <div class="reward-winner-content">
                                            <div class="reward-winner-label">
                                                <i class="bi bi-trophy-fill"></i>
                                                Weekly Winner
                                            </div>
                                            <div class="reward-winner-name" t-esc="weekly_winner_name"/>
                                        </div>
                                    </div>

                                    <div class="reward-winner-note">
                                        <t t-if="weekly_winner_name != 'No winner selected this week'">
                                            This section is visible to all interns and updates weekly.
                                        </t>
                                        <t t-else="">
                                            No weekly winner has been selected for the current week yet.
                                        </t>
                                    </div>
                                    <div class="mt-3 text-center">
                                        <button type="button"
                                                class="reward-claim-btn reward-claim-btn--primary"
                                                data-bs-toggle="modal"
                                                data-bs-target="#weeklyWinnerHistoryModal">
                                            View Winner History
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- TOP INTERNS THIS WEEK -->
                        <div class="col-xl-4 col-lg-6 d-flex">
                            <div class="reward-highlight-card reward-equal-card w-100">
                                <div class="dashboard-header">
                                    <span class="dashboard-title">
                                        <span class="dashboard-icon">
                                            <i class="bi bi-bar-chart-line-fill"></i>
                                        </span>
                                        Top Interns This Week
                                    </span>
                                </div>

                                <div class="reward-highlight-card__body">
                                    <div class="reward-top-list">
                                        <t t-if="top_interns">
                                            <t t-foreach="top_interns" t-as="top_emp">
                                                <div class="reward-top-item d-flex justify-content-between align-items-center">

                                                    <div class="d-flex align-items-center gap-3">
                                                        <div class="reward-top-avatar">
                                                            <img t-att-src="'/web/image/hr.employee/%s/avatar_1920' % top_emp['id']"
                                                                t-att-alt="top_emp['name']"
                                                                class="reward-top-avatar-img"/>
                                                        </div>

                                                        <div class="reward-top-name">
                                                            <t t-esc="top_emp['name']"/>
                                                        </div>
                                                    </div>

                                                    <div class="reward-top-rank-text">
                                                        #<t t-esc="top_emp['rank']"/>
                                                    </div>
                                                </div>
                                            </t>
                                        </t>
                                        <t t-else="">
                                            <div class="reward-highlight-note reward-highlight-note--left">
                                                No intern rankings available for this week yet.
                                            </div>
                                        </t>
                                    </div>

                                    <div class="reward-highlight-note reward-highlight-note--left">
                                        Based on weekly performance metrics of interns in the employee app.
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- PROGRESS SUMMARY -->
                        <div class="col-xl-4 col-lg-12 d-flex">
                            <div class="reward-side-card reward-equal-card w-100">
                                <div class="dashboard-header">
                                    <span class="dashboard-title">
                                        <span class="dashboard-icon">
                                            <i class="bi bi-gift"></i>
                                        </span>
                                        Progress Summary
                                    </span>
                                </div>

                                <div class="reward-side-card__body">
                                    <div class="reward-side-progress">
                                        <div class="reward-side-progress__label">Level Progress</div>

                                        <div class="reward-side-progress__top">
                                            <div class="reward-side-progress__score">
                                                <t t-esc="'%.2f' % rendered_hours"/> / <t t-esc="'%.2f' % contracted_hours"/> hrs
                                            </div>
                                            <div class="reward-side-progress__percent">
                                                <t t-esc="progress_percent"/>%
                                            </div>
                                        </div>

                                        <div class="reward-side-progress__track">
                                            <div class="reward-side-progress__fill"
                                                 t-attf-style="width: #{progress_percent}%"></div>
                                        </div>

                                        <div class="reward-side-progress__meta">
                                            <span>Rendered: <t t-esc="'%.2f' % rendered_hours"/> hrs</span>
                                            <span>Contract: <t t-esc="'%.2f' % contracted_hours"/> hrs</span>
                                        </div>
                                    </div>

                                    <div class="reward-side-details">
                                        <div class="reward-side-detail-row">
                                            <div class="reward-side-detail-label">RANK #</div>
                                            <div class="reward-side-detail-value">
                                                <t t-esc="rank"/>
                                            </div>
                                        </div>

                                        <div class="reward-side-detail-row">
                                            <div class="reward-side-detail-label">BADGES</div>
                                            <div class="reward-side-detail-value">
                                                <t t-esc="badges_count"/>
                                            </div>
                                        </div>

                                        <div class="reward-side-detail-row reward-side-detail-row--last">
                                            <div class="reward-side-detail-label">VOUCHERS AVAILABLE</div>
                                            <div class="reward-side-detail-value reward-side-detail-value--highlight" id="voucher-available-count">
                                                <t t-esc="available_vouchers_count"/>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- BADGES + VOUCHERS -->
                    <div class="row g-4 mt-1 rewards-bottom-row align-items-stretch">

                        <!-- BADGES -->
                        <div class="col-12 d-flex">
                            <div class="reward-section-card w-100">
                                <div class="dashboard-header">
                                    <span class="dashboard-title">
                                        <span class="dashboard-icon">
                                            <i class="bi bi-award"></i>
                                        </span>
                                        Badges
                                    </span>
                                </div>

                                <div class="reward-section-body">
                                    <div class="row g-3 badges-row-horizontal">
                                        <t t-foreach="badges" t-as="badge">
                                            <div class="col-12 col-sm-6 col-lg-3">
                                                <div t-attf-class="reward-item-card reward-item-card--badge #{'reward-item-card--unlocked reward-item-card--active reward-badge-card--animated' if badge['unlocked'] else 'reward-item-card--locked'}">

                                                    <t t-if="badge['unlocked']">
                                                        <div class="reward-status-badge reward-status-badge--unlocked">
                                                            Unlocked
                                                        </div>
                                                    </t>
                                                    <t t-else="">
                                                        <div class="reward-lock-badge">
                                                            <i class="bi bi-lock-fill"></i>
                                                        </div>
                                                    </t>

                                                    <div class="reward-item-icon reward-item-icon--plain">
                                                        <i t-attf-class="bi bi-#{badge['icon']}"></i>
                                                    </div>

                                                    <div class="reward-item-title" t-esc="badge['name']"/>
                                                    <div class="reward-item-desc" t-esc="badge['description']"/>
                                                </div>
                                            </div>
                                        </t>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- VOUCHERS -->
                        <div class="col-12 d-flex">
                            <div class="reward-section-card w-100">
                                <div class="dashboard-header">
                                    <span class="dashboard-title">
                                        <span class="dashboard-icon">
                                            <i class="bi bi-ticket-perforated"></i>
                                        </span>
                                        Vouchers
                                    </span>
                                </div>

                                <div class="reward-section-body">
                                    <div id="voucher-empty-state"
                                        class="reward-empty-state"
                                        t-attf-style="#{'display:flex;' if not available_vouchers_count else 'display:none;'}">
                                        Sorry, No Vouchers Available
                                    </div>

                                    <div class="row g-3 vouchers-grid"
                                        id="voucher-grid"
                                        t-attf-style="#{'display:none;' if not available_vouchers_count else ''}">
                                        <t t-foreach="vouchers" t-as="voucher">
                                            <div class="col-12 col-sm-6 col-lg-3">
                                                <div t-attf-class="reward-item-card reward-item-card--voucher h-100 #{'reward-item-card--unlocked reward-item-card--claimable voucher-card' if voucher['available'] else 'reward-item-card--locked'}"
                                                    t-att-data-voucher-key="voucher['key']"
                                                    t-att-data-voucher-state="'available' if voucher['available'] else 'locked'">

                                                    <t t-if="voucher['available']">
                                                        <div class="reward-status-badge reward-status-badge--available voucher-status">
                                                            Available
                                                        </div>
                                                    </t>
                                                    <t t-else="">
                                                        <div class="reward-lock-badge">
                                                            <i class="bi bi-lock-fill"></i>
                                                        </div>
                                                    </t>

                                                    <div class="reward-item-icon reward-item-icon--plain">
                                                        <i t-attf-class="bi bi-#{voucher['icon']}"></i>
                                                    </div>

                                                    <div class="reward-item-title" t-esc="voucher['name']"/>
                                                    <div class="reward-item-desc voucher-desc" t-esc="voucher['description']"/>

                                                    <t t-if="voucher['available'] and voucher['modal_target']">
                                                        <button type="button"
                                                                class="btn reward-claim-btn reward-claim-btn--primary mt-2 voucher-open-btn"
                                                                data-bs-toggle="modal"
                                                                t-att-data-bs-target="voucher['modal_target']">
                                                            Steps to Claim
                                                        </button>
                                                    </t>
                                                </div>
                                            </div>
                                        </t>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>

            <!-- WEEKLY GAMES WINNER MODAL -->
            <div class="modal fade reward-modal-wrapper" id="weeklyGamesVoucherModal" tabindex="-1" aria-labelledby="weeklyGamesVoucherModalLabel" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered reward-claim-dialog">
                    <div class="modal-content reward-claim-modal">
                        <div class="reward-claim-header">
                            <h5 class="reward-claim-title" id="weeklyGamesVoucherModalLabel">STEPS TO CLAIM</h5>
                            <button type="button" class="reward-claim-close" data-bs-dismiss="modal" aria-label="Close">
                                <i class="bi bi-x-lg"></i>
                            </button>
                        </div>

                        <div class="reward-claim-body">
                            <div class="reward-claim-icon">
                                <i class="bi bi-trophy-fill"></i>
                            </div>

                            <div class="reward-claim-heading">Weekly Games Winner</div>
                            <p class="reward-claim-subtext">Follow these steps to claim your weekly winner voucher.</p>

                            <div class="reward-claim-steps">
                                <ol>
                                    <li>Confirm with HR or your supervisor that you were selected for the current week.</li>
                                    <li>Take a screenshot of the voucher from your rewards page.</li>
                                    <li>Send the screenshot to HR or your assigned contact.</li>
                                    <li>Wait for the redemption instructions or confirmation.</li>
                                </ol>
                            </div>

                            <button type="button"
                                    class="btn reward-claim-action-btn"
                                    data-bs-dismiss="modal">
                                <i class="bi bi-check2-circle me-2"></i>Got it
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- WEBINAR RAFFLE WINNER MODAL -->
            <div class="modal fade reward-modal-wrapper" id="webinarRaffleVoucherModal" tabindex="-1" aria-labelledby="webinarRaffleVoucherModalLabel" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered reward-claim-dialog">
                    <div class="modal-content reward-claim-modal">
                        <div class="reward-claim-header">
                            <h5 class="reward-claim-title" id="webinarRaffleVoucherModalLabel">STEPS TO CLAIM</h5>
                            <button type="button" class="reward-claim-close" data-bs-dismiss="modal" aria-label="Close">
                                <i class="bi bi-x-lg"></i>
                            </button>
                        </div>

                        <div class="reward-claim-body">
                            <div class="reward-claim-icon">
                                <i class="bi bi-ticket-detailed-fill"></i>
                            </div>

                            <div class="reward-claim-heading">Webinar Raffle Winner</div>
                            <p class="reward-claim-subtext">Follow these steps to claim your webinar raffle reward.</p>

                            <div class="reward-claim-steps">
                                <ol>
                                    <li>Check that HR has marked the voucher as available in your rewards page.</li>
                                    <li>Take a screenshot of the voucher details.</li>
                                    <li>Send the screenshot to HR or your supervisor.</li>
                                    <li>Wait for the final claim and redemption instructions.</li>
                                </ol>
                            </div>

                            <button type="button"
                                    class="btn reward-claim-action-btn"
                                    data-bs-dismiss="modal">
                                <i class="bi bi-check2-circle me-2"></i>Got it
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="modal fade" id="weeklyWinnerHistoryModal" tabindex="-1">
                <div class="modal-dialog modal-dialog-centered reward-claim-dialog">
                    <div class="modal-content reward-claim-modal">

                        <div class="reward-claim-header">
                            <h5 class="reward-claim-title">WINNER HISTORY</h5>
                            <button type="button" class="reward-claim-close" data-bs-dismiss="modal">
                                <i class="bi bi-x-lg"></i>
                            </button>
                        </div>

                        <div class="reward-claim-body">

                            <div class="reward-claim-icon reward-claim-icon--gold">
                                <i class="bi bi-trophy-fill"></i>
                            </div>

                            <div class="reward-claim-heading">
                                Weekly Winners
                            </div>

                            <div class="reward-claim-subtext">
                                Here are the most recent Weekly Games Winners.
                            </div>

                            <div class="reward-claim-steps">
                                <t t-if="winner_history">
                                    <ol>
                                        <t t-foreach="winner_history" t-as="winner">
                                            <li>
                                                <strong t-esc="winner['name']"/> –
                                                <span t-esc="winner['week_start']"/>
                                            </li>
                                        </t>
                                    </ol>
                                </t>

                                <t t-else="">
                                    <div class="text-center text-muted" style="padding: 0.5rem 0;">
                                        No winner history available yet.
                                    </div>
                                </t>
                            </div>

                        </div>

                    </div>
                </div>
            </div>

            <canvas id="reward-confetti-canvas" class="reward-confetti-canvas"></canvas>

            <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

            <script><![CDATA[
                document.addEventListener('DOMContentLoaded', function () {
                    function updateAvailableVoucherCount() {
                        const availableCards = document.querySelectorAll('.voucher-card[data-voucher-state="available"]').length;
                        const countTarget = document.getElementById('voucher-available-count');
                        const voucherGrid = document.getElementById('voucher-grid');
                        const emptyState = document.getElementById('voucher-empty-state');

                        if (countTarget) {
                            countTarget.textContent = availableCards;
                        }

                        if (voucherGrid && emptyState) {
                            if (availableCards === 0) {
                                voucherGrid.style.display = 'none';
                                emptyState.style.display = 'flex';
                            } else {
                                voucherGrid.style.display = '';
                                emptyState.style.display = 'none';
                            }
                        }
                    }

                    updateAvailableVoucherCount();

                    /* =========================
                       SCROLL REVEAL
                    ========================= */
                        const revealTargets = [
                            ...document.querySelectorAll('.reward-highlight-card'),
                            ...document.querySelectorAll('.reward-side-card'),
                            ...document.querySelectorAll('.reward-section-card'),
                            ...document.querySelectorAll('.reward-item-card'),
                            ...document.querySelectorAll('.reward-top-item')
                        ];

                        revealTargets.forEach(function (el, index) {
                            el.classList.add('reveal-on-scroll');
                            el.classList.add('reveal-delay-' + ((index % 6) + 1));
                        });

                    const revealObserver = new IntersectionObserver(function (entries, observer) {
                        entries.forEach(function (entry) {
                            if (entry.isIntersecting) {
                                entry.target.classList.add('is-visible');
                                observer.unobserve(entry.target);
                            }
                        });
                    }, {
                        threshold: 0.12,
                        rootMargin: '0px 0px -40px 0px'
                    });

                    revealTargets.forEach(function (el) {
                        revealObserver.observe(el);
                    });

                    const canvas = document.getElementById('reward-confetti-canvas');
                    if (!canvas) {
                        console.error('Confetti canvas not found.');
                        return;
                    }

                    const ctx = canvas.getContext('2d');
                    let confettiPieces = [];
                    let animationFrameId = null;

                    function resizeCanvas() {
                        canvas.width = window.innerWidth;
                        canvas.height = window.innerHeight;
                    }

                    function random(min, max) {
                        return Math.random() * (max - min) + min;
                    }

                    function createConfettiBurst(x, y) {
                        const colors = [
                            '#0e4174',
                            '#052348',
                            '#bf9e3c',
                            '#937A40',
                            '#CFDEEB',
                            '#FFD285'
                        ];

                        for (let i = 0; i < 140; i++) {
                            confettiPieces.push({
                                x: x,
                                y: y,
                                size: random(6, 12),
                                color: colors[Math.floor(Math.random() * colors.length)],
                                speedX: random(-7, 7),
                                speedY: random(-11, -4),
                                gravity: 0.2,
                                rotation: random(0, 360),
                                rotationSpeed: random(-10, 10),
                                alpha: 1
                            });
                        }

                        if (!animationFrameId) {
                            animateConfetti();
                        }
                    }

                    function animateConfetti() {
                        ctx.clearRect(0, 0, canvas.width, canvas.height);

                        confettiPieces.forEach(function (piece) {
                            piece.x += piece.speedX;
                            piece.y += piece.speedY;
                            piece.speedY += piece.gravity;
                            piece.rotation += piece.rotationSpeed;
                            piece.alpha -= 0.008;
                        });

                        confettiPieces = confettiPieces.filter(function (piece) {
                            return piece.alpha > 0;
                        });

                        confettiPieces.forEach(function (piece) {
                            ctx.save();
                            ctx.globalAlpha = piece.alpha;
                            ctx.translate(piece.x, piece.y);
                            ctx.rotate(piece.rotation * Math.PI / 180);
                            ctx.fillStyle = piece.color;
                            ctx.fillRect(-piece.size / 2, -piece.size / 2, piece.size, piece.size * 0.6);
                            ctx.restore();
                        });

                        if (confettiPieces.length > 0) {
                            animationFrameId = requestAnimationFrame(animateConfetti);
                        } else {
                            animationFrameId = null;
                            ctx.clearRect(0, 0, canvas.width, canvas.height);
                        }
                    }

                    resizeCanvas();
                    window.addEventListener('resize', resizeCanvas);

                    document.querySelectorAll('.voucher-open-btn').forEach(function (button) {
                        button.addEventListener('click', function () {
                            const targetModalSelector = button.getAttribute('data-bs-target');
                            if (!targetModalSelector) return;

                            const modalEl = document.querySelector(targetModalSelector);
                            if (!modalEl) return;

                            modalEl.addEventListener('shown.bs.modal', function handler() {
                                const centerX = window.innerWidth / 2;
                                const centerY = window.innerHeight / 2;

                                createConfettiBurst(centerX, centerY);

                                setTimeout(function () {
                                    createConfettiBurst(centerX - 150, centerY);
                                }, 250);

                                setTimeout(function () {
                                    createConfettiBurst(centerX + 150, centerY);
                                }, 500);

                                modalEl.removeEventListener('shown.bs.modal', handler);
                            });
                        });
                    });
                });
            ]]></script>
        </div>
    </template>
</odoo>