<odoo>
    <!-- REUSABLE STEPS TO CLAIM BLOCK -->
    <template id="claim_steps" name="Reward Claim Steps">
        <div class="reward-claim-steps">
            <ol>
                <li>Open the <strong>Approvals</strong> app.</li>
                <li>Click <strong>New Request</strong>.</li>
                <li>Enter the <strong>Approval Subject</strong> or payment request name.</li>
                <li>Set <strong>Request Owner</strong> to <strong>FAMTECH INNOVATIVE EMPLOYEES</strong>.</li>
                <li>Select <strong>Category: Payment Application</strong>.</li>
                <li>Choose the <strong>filing date</strong>.</li>
                <li>Select your name under <strong>Contact</strong>.</li>
                <li>Enter the <strong>amount requested</strong>.</li>
                <li>Add your <strong>payment details</strong> in the description.</li>
                <li>Under <strong>Approver</strong>, add <strong>FAMTECH INNOVATIVE</strong>.</li>
                <li>Send a message tagging <strong>@FAMTECH INNOVATIVE</strong>, such as “For approval”.</li>
                <li>Attach your <strong>receipt or supporting document</strong>.</li>
                <li>Click <strong>Submit</strong>.</li>
            </ol>

            <p class="reward-claim-note">
                <strong>Note:</strong> Do not create duplicate requests to correct a filing.
                To make changes, open your request, click <strong>Cancel</strong>, select
                <strong>Back to Draft</strong>, update the necessary fields, then
                <strong>resubmit</strong>.
            </p>
        </div>
    </template>

    <template id="intern_rewards" name="Intern Rewards">
        <t t-call="famtech_intern_dashboard.intern_navbar"/>
        <head>
            <title>Intern Rewards</title>
            <meta charset="utf-8"/>
            <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
            <link rel="preconnect" href="https://fonts.googleapis.com"/>
            <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="crossorigin"/>
            <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&amp;display=swap" rel="stylesheet"/>
            <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet"/>
            <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"/>
            <link href="/famtech_intern_dashboard/static/src/website/css/global.css" rel="stylesheet"/>
            <link href="/famtech_intern_dashboard/static/src/website/css/rewards.css" rel="stylesheet"/>
        </head>

        <div class="intern-rewards-page">
            <div class="w-100 main-bg" style="min-height: 100vh; font-family: 'Poppins', sans-serif;">
                <div class="container py-5">

                    <div>
                        <h4 class="mb-1 fw-bold" style="text-transform: uppercase;">Rewards</h4>
                        <p class="text-muted mb-0" style="font-size: 0.9rem;">
                            Track your achievements, unlock badges, and claim vouchers based on your internship progress and performance.
                        </p>
                    </div>

                    <hr class="brand-divider mb-4"/>

                    <!-- TOP SECTION -->
                    <div class="row g-4 rewards-top-row align-items-stretch">

                        <!-- WEEKLY GAMES WINNER -->
                        <div class="col-xl-4 col-lg-6 d-flex">
                            <div class="card reward-highlight-card reward-highlight-card--winner reward-equal-card w-100">
                                <div class="dashboard-header">
                                    <span class="dashboard-title">
                                        <span class="dashboard-icon">
                                            <i class="bi bi-trophy-fill"></i>
                                        </span>
                                        Weekly Games Winner
                                    </span>
                                </div>

                                <div class="reward-highlight-card__body reward-highlight-card__body--winner">
                                    <div class="reward-winner-pill">
                                        <i class="bi bi-calendar-week"></i>
                                        <span t-esc="current_week_label"/>
                                    </div>

                                    <div class="reward-winner-profile">
                                        <div class="reward-winner-photo-wrap">
                                            <div class="reward-winner-photo-frame">
                                                <img t-att-src="weekly_winner_image_url"
                                                     alt="Weekly Winner"
                                                     class="reward-winner-photo"/>
                                            </div>
                                        </div>

                                        <div class="reward-winner-content">
                                            <div class="reward-winner-label">
                                                <i class="bi bi-trophy-fill"></i>
                                                Weekly Winner
                                            </div>
                                            <div class="reward-winner-name" t-esc="weekly_winner_name"/>
                                        </div>
                                    </div>

                                    <div class="reward-winner-note">
                                        <t t-if="weekly_winner_name != 'No winner selected this week'">
                                            This section is visible to all interns and updates weekly.
                                        </t>
                                        <t t-else="">
                                            No weekly winner has been selected for the current week yet.
                                        </t>
                                    </div>

                                    <div class="mt-3 text-center">
                                        <button type="button"
                                                class="btn btn-primary reward-claim-btn"
                                                data-bs-toggle="modal"
                                                data-bs-target="#weeklyWinnerHistoryModal">
                                            <i class="bi bi-clock-history me-2"></i>View Winner History
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- TOP INTERNS THIS WEEK -->
                        <div class="col-xl-4 col-lg-6 d-flex">
                            <div class="card reward-highlight-card reward-equal-card w-100">
                                <div class="dashboard-header">
                                    <span class="dashboard-title">
                                        <span class="dashboard-icon">
                                            <i class="bi bi-bar-chart-line-fill"></i>
                                        </span>
                                        Top Interns This Week
                                    </span>
                                </div>

                                <div class="reward-highlight-card__body">
                                    <div class="reward-top-list">
                                        <t t-if="top_interns">
                                            <t t-foreach="top_interns" t-as="top_emp">
                                                <div class="reward-top-item d-flex justify-content-between align-items-center">
                                                    <div class="d-flex align-items-center gap-3">
                                                        <div class="reward-top-avatar">
                                                            <img t-att-src="'/web/image/hr.employee/%s/avatar_1920' % top_emp['id']"
                                                                 t-att-alt="top_emp['name']"
                                                                 class="reward-top-avatar-img"/>
                                                        </div>
                                                        <div class="reward-top-name">
                                                            <t t-esc="top_emp['name']"/>
                                                        </div>
                                                    </div>

                                                    <div class="reward-top-rank-text">
                                                        #<t t-esc="top_emp['rank']"/>
                                                    </div>
                                                </div>
                                            </t>
                                        </t>
                                        <t t-else="">
                                            <div class="reward-highlight-note reward-highlight-note--left">
                                                No intern rankings available for this week yet.
                                            </div>
                                        </t>
                                    </div>

                                    <div class="reward-highlight-note reward-highlight-note--left">
                                        Based on weekly performance metrics of interns in the employee app.
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- PROGRESS SUMMARY -->
                        <div class="col-xl-4 col-lg-12 d-flex">
                            <div class="card reward-side-card reward-equal-card w-100">
                                <div class="dashboard-header">
                                    <span class="dashboard-title">
                                        <span class="dashboard-icon">
                                            <i class="bi bi-gift"></i>
                                        </span>
                                        Progress Summary
                                    </span>
                                </div>

                                <div class="reward-side-card__body">
                                    <div class="reward-side-progress">
                                        <div class="reward-side-progress__label">Level Progress</div>

                                        <div class="reward-side-progress__top">
                                            <div class="reward-side-progress__score">
                                                <t t-esc="'%.2f' % rendered_hours"/> / <t t-esc="'%.2f' % contracted_hours"/> hrs
                                            </div>
                                            <div class="reward-side-progress__percent">
                                                <t t-esc="progress_percent"/>%
                                            </div>
                                        </div>

                                        <div class="reward-side-progress__track">
                                            <div class="reward-side-progress__fill"
                                                 t-attf-style="width: #{progress_percent}%"></div>
                                        </div>

                                        <div class="reward-side-progress__meta">
                                            <span>Rendered: <t t-esc="'%.2f' % rendered_hours"/> hrs</span>
                                            <span>Contract: <t t-esc="'%.2f' % contracted_hours"/> hrs</span>
                                        </div>
                                    </div>

                                    <div class="reward-side-details">
                                        <div class="reward-side-detail-row">
                                            <div class="reward-side-detail-label">RANK #</div>
                                            <div class="reward-side-detail-value">
                                                <t t-esc="rank"/>
                                            </div>
                                        </div>

                                        <div class="reward-side-detail-row">
                                            <div class="reward-side-detail-label">BADGES</div>
                                            <div class="reward-side-detail-value">
                                                <t t-esc="badges_count"/>
                                            </div>
                                        </div>

                                        <div class="reward-side-detail-row reward-side-detail-row--last">
                                            <div class="reward-side-detail-label">VOUCHERS AVAILABLE</div>
                                            <div class="reward-side-detail-value reward-side-detail-value--highlight" id="voucher-available-count">
                                                <t t-esc="available_vouchers_count"/>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- BADGES + VOUCHERS -->
                    <div class="row g-4 mt-1 rewards-bottom-row align-items-stretch">

                        <!-- BADGES -->
                        <div class="col-12 d-flex">
                            <div class="card reward-section-card w-100">
                                <div class="dashboard-header">
                                    <span class="dashboard-title">
                                        <span class="dashboard-icon">
                                            <i class="bi bi-award"></i>
                                        </span>
                                        Badges
                                    </span>
                                </div>

                                <div class="reward-section-body">
                                    <div class="row g-3 badges-row-horizontal">
                                        <t t-foreach="badges" t-as="badge">
                                            <div class="col-12 col-sm-6 col-lg-3">
                                                <div t-attf-class="card reward-item-card reward-item-card--badge #{'reward-item-card--unlocked reward-item-card--active' if badge['unlocked'] else 'reward-item-card--locked'}">
                                                    <t t-if="badge['unlocked']">
                                                        <div class="reward-status-badge reward-status-badge--unlocked">Unlocked</div>
                                                    </t>
                                                    <t t-else="">
                                                        <div class="reward-lock-badge">
                                                            <i class="bi bi-lock-fill"></i>
                                                        </div>
                                                    </t>

                                                    <div class="reward-item-icon reward-item-icon--plain">
                                                        <i t-attf-class="bi bi-#{badge['icon']}"></i>
                                                    </div>

                                                    <div class="reward-item-title" t-esc="badge['name']"/>
                                                    <div class="reward-item-desc" t-esc="badge['description']"/>
                                                </div>
                                            </div>
                                        </t>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- VOUCHERS -->
                        <div class="col-12 d-flex">
                            <div class="card reward-section-card w-100">
                                <div class="dashboard-header">
                                    <span class="dashboard-title">
                                        <span class="dashboard-icon">
                                            <i class="bi bi-ticket-perforated"></i>
                                        </span>
                                        Vouchers
                                    </span>
                                </div>

                                <div class="reward-section-body">
                                    <!-- AVAILABLE VOUCHERS -->
                                    <div id="voucher-empty-state"
                                         class="reward-empty-state"
                                         t-attf-style="#{'display:flex;' if not available_vouchers_count else 'display:none;'}">
                                        Sorry, no vouchers available.
                                    </div>

                                    <div class="row g-3 vouchers-grid"
                                         id="voucher-grid"
                                         t-attf-style="#{'display:none;' if not available_vouchers_count else ''}">
                                        <t t-foreach="available_vouchers" t-as="voucher">
                                            <div class="col-12 col-sm-6 col-lg-3">
                                                <div class="card reward-item-card reward-item-card--voucher h-100 reward-item-card--unlocked reward-item-card--claimable voucher-card"
                                                     t-att-data-voucher-key="voucher['key']"
                                                     data-voucher-state="available">

                                                    <div class="reward-status-badge reward-status-badge--available voucher-status">Available</div>

                                                    <div class="reward-item-icon reward-item-icon--plain">
                                                        <i t-attf-class="bi bi-#{voucher['icon']}"></i>
                                                    </div>

                                                    <div class="reward-item-title" t-esc="voucher['name']"/>

                                                    <t t-if="voucher['modal_target']">
                                                        <button type="button"
                                                                class="btn btn-primary reward-claim-btn mt-2 voucher-open-btn"
                                                                data-bs-toggle="modal"
                                                                t-att-data-bs-target="voucher['modal_target']"
                                                                t-att-data-voucher-name="voucher['name']">
                                                            <i class="bi bi-list-check me-2"></i>Steps to Claim
                                                        </button>
                                                    </t>
                                                </div>
                                            </div>
                                        </t>
                                    </div>

                                    <div class="mt-3 text-center">
                                        <button type="button"
                                                class="btn btn-primary reward-claim-btn"
                                                data-bs-toggle="modal"
                                                data-bs-target="#voucherHistoryModal">
                                            <i class="bi bi-clock-history me-2"></i>View Voucher History
                                        </button>
                                    </div>

                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>

            <!-- WEEKLY GAMES WINNER MODAL -->
            <div class="modal fade reward-modal-wrapper" id="weeklyGamesVoucherModal" tabindex="-1" aria-labelledby="weeklyGamesVoucherModalLabel" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered reward-claim-dialog">
                    <div class="modal-content reward-claim-modal">
                        <div class="reward-claim-header">
                            <h5 class="reward-claim-title" id="weeklyGamesVoucherModalLabel">STEPS TO CLAIM</h5>
                            <button type="button" class="reward-claim-close" data-bs-dismiss="modal" aria-label="Close">
                                <i class="bi bi-x-lg"></i>
                            </button>
                        </div>

                        <div class="reward-claim-body">
                            <div class="reward-claim-icon">
                                <i class="bi bi-trophy-fill"></i>
                            </div>

                            <div class="reward-claim-heading">Weekly Game Prize</div>
                            <p class="reward-claim-subtext">Follow these steps to submit your claim request.</p>

                            <t t-call="famtech_intern_dashboard.claim_steps"/>

                            <button type="button"
                                    class="btn btn-primary reward-claim-action-btn"
                                    data-bs-dismiss="modal">
                                <i class="bi bi-check2-circle me-2"></i>Got it
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- DYNAMIC VOUCHER MODAL -->
            <div class="modal fade reward-modal-wrapper" id="dynamicVoucherModal" tabindex="-1" aria-labelledby="dynamicVoucherModalLabel" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered reward-claim-dialog">
                    <div class="modal-content reward-claim-modal">
                        <div class="reward-claim-header">
                            <h5 class="reward-claim-title" id="dynamicVoucherModalLabel">STEPS TO CLAIM</h5>
                            <button type="button" class="reward-claim-close" data-bs-dismiss="modal" aria-label="Close">
                                <i class="bi bi-x-lg"></i>
                            </button>
                        </div>

                        <div class="reward-claim-body">
                            <div class="reward-claim-icon">
                                <i class="bi bi-gift-fill"></i>
                            </div>

                            <div class="reward-claim-heading" id="dynamicVoucherTitle">Voucher Claim Request</div>
                            <p class="reward-claim-subtext">Follow these steps to submit your claim request.</p>

                            <t t-call="famtech_intern_dashboard.claim_steps"/>

                            <button type="button"
                                    class="btn btn-primary reward-claim-action-btn"
                                    data-bs-dismiss="modal">
                                <i class="bi bi-check2-circle me-2"></i>Got it
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- WEEKLY WINNER HISTORY MODAL -->
            <div class="modal fade" id="weeklyWinnerHistoryModal" tabindex="-1">
                <div class="modal-dialog modal-dialog-centered reward-claim-dialog">
                    <div class="modal-content reward-claim-modal">
                        <div class="reward-claim-header">
                            <h5 class="reward-claim-title">WINNER HISTORY</h5>
                            <button type="button" class="reward-claim-close" data-bs-dismiss="modal">
                                <i class="bi bi-x-lg"></i>
                            </button>
                        </div>

                        <div class="reward-claim-body">
                            <div class="reward-claim-icon reward-claim-icon--gold">
                                <i class="bi bi-trophy-fill"></i>
                            </div>

                            <div class="reward-claim-heading">Weekly Winners</div>
                            <div class="reward-claim-subtext">Here are the most recent Weekly Games Winners.</div>

                            <div class="reward-claim-steps">
                                <t t-if="winner_history">
                                    <ol>
                                        <t t-foreach="winner_history" t-as="winner">
                                            <li>
                                                <strong t-esc="winner['name']"/> –
                                                <span t-esc="winner['week_start']"/>
                                            </li>
                                        </t>
                                    </ol>
                                </t>
                                <t t-else="">
                                    <div class="text-center text-muted" style="padding: 0.5rem 0;">
                                        No winner history available yet.
                                    </div>
                                </t>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- VOUCHER HISTORY MODAL -->
            <div class="modal fade" id="voucherHistoryModal" tabindex="-1">
                <div class="modal-dialog modal-dialog-centered reward-claim-dialog">
                    <div class="modal-content reward-claim-modal">

                        <div class="reward-claim-header">
                            <h5 class="reward-claim-title">VOUCHER HISTORY</h5>
                            <button type="button" class="reward-claim-close" data-bs-dismiss="modal">
                                <i class="bi bi-x-lg"></i>
                            </button>
                        </div>

                        <div class="reward-claim-body">
                            <div class="reward-claim-icon">
                                <i class="bi bi-clock-history"></i>
                            </div>

                            <div class="reward-claim-heading">
                                Claimed Vouchers
                            </div>

                            <div class="reward-claim-subtext">
                                View all vouchers assigned and claimed.
                            </div>

                            <div class="reward-claim-steps">

                                <t t-if="claimed_vouchers">
                                    <ol>
                                        <t t-foreach="claimed_vouchers" t-as="voucher">
                                            <li>
                                                <strong t-esc="voucher['name']"/>

                                                <t t-if="voucher['key'] == 'weekly_game_prize'">
                                                    <br/>
                                                    <span>
                                                        Winning Week:
                                                        <strong t-esc="current_week_label"/>
                                                    </span>
                                                </t>

                                                <t t-else="">
                                                    <br/>
                                                    <span>
                                                        Claimed:
                                                        <t t-if="voucher.get('claimed_at')">
                                                            <strong t-esc="voucher['claimed_at'].strftime('%B %d, %Y %I:%M %p')"/>
                                                        </t>
                                                        <t t-else="">
                                                            Not yet claimed
                                                        </t>
                                                    </span>
                                                </t>
                                            </li>
                                        </t>
                                    </ol>
                                </t>

                                <t t-else="">
                                    <div class="text-center text-muted" style="padding: 0.5rem 0;">
                                        No voucher history available yet.
                                    </div>
                                </t>

                            </div>

                        </div>

                    </div>
                </div>
            </div>

            <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
            <script><![CDATA[
                document.addEventListener('DOMContentLoaded', function () {
                    const dynamicVoucherTitle = document.getElementById('dynamicVoucherTitle');

                    document.querySelectorAll('.voucher-open-btn').forEach(function (button) {
                        button.addEventListener('click', function () {
                            const voucherName = button.getAttribute('data-voucher-name');
                            if (dynamicVoucherTitle && voucherName) {
                                dynamicVoucherTitle.textContent = voucherName;
                            }
                        });
                    });
                });
            ]]></script>
        </div>
    </template>
</odoo>
