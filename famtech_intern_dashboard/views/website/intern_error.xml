<odoo>
    <template id="intern_error_page" name="Intern Error Page">
        <t t-call="web.html_container">
            <t t-set="title"><t t-esc="error_code or '404'"/> <t t-esc="error_title or 'Page Not Found'"/></t>

            <link rel="preconnect" href="https://fonts.googleapis.com"/>
            <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="crossorigin"/>
            <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&amp;display=swap" rel="stylesheet"/>
            <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet"/>
            <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"/>

            <section class="intern-error-page d-flex align-items-center justify-content-center">
                <div class="container">
                    <div class="row justify-content-center">
                        <div class="col-12 col-xl-10">
                            <div class="intern-error-card">
                                <div class="intern-error-content text-center">

                                    <div class="intern-error-icon mx-auto mb-4">
                                        <i class="bi bi-exclamation-triangle"></i>
                                    </div>

                                    <div class="intern-error-pill mx-auto mb-4">
                                        Oops! Something went wrong
                                    </div>

                                    <h1 class="intern-error-code mb-2">
                                        <t t-esc="error_code or '404'"/>
                                    </h1>

                                    <h2 class="intern-error-title mb-3">
                                        <t t-esc="error_title or 'Page not found'"/>
                                    </h2>

                                    <p class="intern-error-message mb-4">
                                        <t t-esc="error_message or 'The page you are looking for could not be found.'"/>
                                    </p>

                                    <!-- 403: show only Go to Login -->
                                    <t t-if="(error_code or '404') == '403'">
                                        <div class="d-flex justify-content-center mb-4">
                                            <a href="/web/login"
                                               class="intern-btn intern-btn-secondary">
                                                <i class="bi bi-arrow-left me-2"></i>
                                                Go to Login
                                            </a>
                                        </div>
                                    </t>

                                    <!-- Other errors: keep original buttons -->
                                    <t t-else="">
                                        <div class="d-flex flex-column flex-sm-row justify-content-center gap-3 mb-4">
                                            <a t-att-href="primary_url or '/dashboard'"
                                               class="intern-btn intern-btn-primary">
                                                <i class="bi bi-house-door me-2"></i>
                                                <t t-esc="primary_label or 'Go to Dashboard'"/>
                                            </a>

                                            <a t-att-href="secondary_url or 'javascript:history.back()'"
                                               class="intern-btn intern-btn-secondary">
                                                <i class="bi bi-arrow-left me-2"></i>
                                                <t t-esc="secondary_label or 'Go Back'"/>
                                            </a>
                                        </div>
                                    </t>

                                    <p class="intern-error-help mb-0">
                                        Need help? Contact your administrator or try again later.
                                    </p>

                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <style>
                :root {
                    --color-gold-100: #FFF2D1;
                    --color-gold-300: #FFD285;
                    --color-gold-500: #bf9e3c;
                    --color-gold-700: #937A40;
                    --color-gold-900: #5C4525;

                    --color-navy-100: #CFDEEB;
                    --color-navy-300: #709ECB;
                    --color-navy-500: #0e4174;
                    --color-navy-700: #052348;
                    --color-navy-900: #02142A;

                    --color-gray-100: #F3F4F6;
                    --color-gray-300: #D1D5DB;
                    --color-gray-500: #6B7280;
                    --color-gray-700: #374151;
                    --color-gray-900: #1A1A1A;

                    --color-white: #fefefe;
                    --color-black: #000000;
                }

                html, body {
                    margin: 0;
                    padding: 0;
                    font-family: 'Poppins', sans-serif;
                    background: #f1f2f4;
                }

                .intern-error-page {
                    min-height: 100vh;
                    padding: 36px 16px;
                    background:
                        radial-gradient(circle at 50% 0%,
                            var(--color-white) 0%,
                            var(--color-gray-100) 70%,
                            #ececec 100%);
                }

                .intern-error-card {
                    width: 100%;
                    max-width: 950px;
                    margin: 0 auto;
                    background: var(--color-white);
                    border: 1px solid rgba(209, 213, 219, 0.8);
                    border-radius: 28px;
                    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.04);
                    min-height: 640px;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                }

                .intern-error-content {
                    width: 100%;
                    max-width: 700px;
                    padding: 40px 20px;
                }

                .intern-error-icon {
                    width: 102px;
                    height: 102px;
                    border-radius: 50%;
                    background: var(--color-gold-100);
                    color: var(--color-gold-900);
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    font-size: 2.5rem;
                    box-shadow: 0 8px 22px rgba(191, 158, 60, 0.12);
                }

                .intern-error-pill {
                    display: inline-flex;
                    align-items: center;
                    justify-content: center;
                    padding: 0.8rem 1.5rem;
                    border-radius: 999px;
                    background: #cfdceb;
                    color: var(--color-navy-700);
                    font-weight: 700;
                    font-size: 1rem;
                    line-height: 1;
                }

                .intern-error-code {
                    font-size: clamp(5rem, 10vw, 7rem);
                    line-height: 0.95;
                    font-weight: 800;
                    letter-spacing: -0.04em;
                    color: var(--color-navy-500);
                    margin: 0;
                }

                .intern-error-title {
                    font-size: clamp(2.2rem, 4vw, 3rem);
                    line-height: 1.08;
                    font-weight: 700;
                    color: var(--color-navy-500);
                    margin: 0;
                }

                .intern-error-message {
                    max-width: 620px;
                    margin-left: auto;
                    margin-right: auto;
                    font-size: 1.2rem;
                    line-height: 1.6;
                    color: var(--color-gray-500);
                }

                .intern-error-help {
                    font-size: 1.05rem;
                    line-height: 1.5;
                    color: var(--color-gray-500);
                }

                .intern-btn {
                    min-width: 235px;
                    min-height: 52px;
                    padding: 0.78rem 1.5rem;
                    border-radius: 10px;
                    font-size: 1rem;
                    font-weight: 700;
                    text-decoration: none;
                    display: inline-flex;
                    align-items: center;
                    justify-content: center;
                    border: none;
                    transition: all 0.25s ease;
                }

                .intern-btn:hover {
                    transform: translateY(-1px);
                    text-decoration: none;
                }

                .intern-btn-primary,
                .intern-btn-primary:visited,
                .intern-btn-primary:hover,
                .intern-btn-primary:focus,
                .intern-btn-primary:active {
                    background: #0e4174 !important;
                    color: #fefefe !important;
                    box-shadow: 0 6px 16px rgba(6, 38, 71, 0.25);
                }

                .intern-btn-primary:hover,
                .intern-btn-primary:focus {
                    background: #052348 !important;
                }

                .intern-btn-secondary,
                .intern-btn-secondary:visited,
                .intern-btn-secondary:hover,
                .intern-btn-secondary:focus,
                .intern-btn-secondary:active {
                    background: #bf9e3c !important;
                    color: #fefefe !important;
                    box-shadow: 0 6px 16px rgba(191, 158, 60, 0.25);
                }

                .intern-btn-secondary:hover,
                .intern-btn-secondary:focus {
                    background: #937A40 !important;
                }

                @media (max-width: 767.98px) {
                    .intern-error-page {
                        padding: 16px;
                    }

                    .intern-error-card {
                        min-height: auto;
                        border-radius: 22px;
                    }

                    .intern-error-content {
                        padding: 32px 12px;
                    }

                    .intern-error-icon {
                        width: 84px;
                        height: 84px;
                        font-size: 2rem;
                    }

                    .intern-error-pill {
                        font-size: 0.92rem;
                        padding: 0.7rem 1rem;
                    }

                    .intern-error-message,
                    .intern-error-help {
                        font-size: 1rem;
                    }

                    .intern-btn {
                        width: 100%;
                        min-width: unset;
                    }
                }
            </style>

            <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
        </t>
    </template>
</odoo>