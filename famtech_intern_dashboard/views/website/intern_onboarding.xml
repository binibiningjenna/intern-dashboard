<odoo>
    <template id="intern_onboarding_page" name="Intern Onboarding">
        <t t-call="famtech_intern_dashboard.intern_navbar"/>
        <head>
            <title>Intern Onboarding</title>
            <meta charset="utf-8"/>
            <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
            <link rel="preconnect" href="https://fonts.googleapis.com"/>
            <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="crossorigin"/>
            <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&amp;display=swap" rel="stylesheet"/>
            <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet"/>
            <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"/>
            <link href="/famtech_intern_dashboard/static/src/website/css/global.css" rel="stylesheet"/>
            <link href="/famtech_intern_dashboard/static/src/website/css/onboarding.css" rel="stylesheet"/>
        </head>

        <div class="w-100 onboarding-wrapper">
            <div class="container py-5">

                <!-- Page Header -->
                <div class="row mb-4">
                    <div class="col-12">
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <i class="bi bi-clipboard2-check onboarding-icon-header"></i>
                            <h1 class="fw-bold mb-0">Onboarding Plan</h1>
                        </div>
                        <p class="onboarding-subtitle">
                            Welcome, <strong><t t-out="employee.name"/></strong>.
                            Complete each step to finish your onboarding.
                        </p>
                    </div>
                </div>
                
                <!-- Completion Banner — only shows when all steps done -->
                <t t-if="progress == 100">
                    <div class="row mb-4">
                        <div class="col-12">
                            <div class="d-flex align-items-center gap-3 p-3 rounded-3"
                                style="background-color: var(--color-navy-100); border: 1px solid var(--color-navy-300);">
                                <i class="bi bi-patch-check-fill fs-4" style="color: var(--color-navy-500);"></i>
                                <div>
                                    <div class="fw-bold" style="color: var(--color-navy-700);">
                                        Onboarding Complete!
                                    </div>
                                    <div class="small" style="color: var(--color-navy-500);">
                                        You have completed all onboarding steps. Great work, <t t-out="employee.name"/>!
                                    </div>
                                </div>
                                <a href="/my/intern_dashboard" class="btn btn-primary btn-sm ms-auto px-3">
                                    <i class="bi bi-speedometer2 me-1"></i>Go to Dashboard
                                </a>
                            </div>
                        </div>
                    </div>
                </t>

                <div class="row g-4">

                    <!-- LEFT: Checklist -->
                    <div class="col-lg-8">
                        <div class="card">
                            <div class="card-header d-flex align-items-center gap-2">
                                <i class="bi bi-list-check onboarding-icon-header"></i>
                                <span>Complete Your Onboarding Steps</span>
                            </div>
                            <div class="card-body p-0">
                                <form action="/onboarding/update" method="POST">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                                    <!-- Step 1 -->
                                    <div class="onboarding-step d-flex align-items-center justify-content-between">
                                        <div class="d-flex align-items-center gap-3">
                                            <div t-attf-class="step-icon {{ 'step-icon--done' if employee.handbook_reviewed else 'step-icon--pending' }}">
                                                <i t-attf-class="bi {{ 'bi-check-lg' if employee.handbook_reviewed else 'bi-book' }}"></i>
                                            </div>
                                            <div>
                                                <div class="fw-semibold">Step 1 — Read Intern Handbook</div>
                                                <div class="mt-1">
                                                    <span t-attf-class="badge-status {{ 'badge-status--done' if employee.handbook_reviewed else 'badge-status--pending' }}">
                                                        <i t-attf-class="bi {{ 'bi-check-circle' if employee.handbook_reviewed else 'bi-clock' }} me-1"></i>
                                                        <t t-if="employee.handbook_reviewed">Completed</t>
                                                        <t t-else="">Pending</t>
                                                    </span>
                                                </div>
                                            </div>
                                        </div>
                                        <a href="/my/intern/handbook/download" target="_blank" class="btn btn-secondary btn-sm px-3">
                                            <i class="bi bi-file-earmark-text me-1"></i>Intern Handbook
                                        </a>
                                    </div>

                                    <!-- Step 2 -->
                                    <div class="onboarding-step d-flex align-items-center justify-content-between">
                                        <div class="d-flex align-items-center gap-3">
                                            <div t-attf-class="step-icon {{ 'step-icon--done' if employee.orientation_completed else 'step-icon--pending' }}">
                                                <i t-attf-class="bi {{ 'bi-check-lg' if employee.orientation_completed else 'bi-camera-video' }}"></i>
                                            </div>
                                            <div>
                                                <div class="fw-semibold">Step 2 — Attend Orientation Session</div>
                                                <div class="mt-1">
                                                    <span t-attf-class="badge-status {{ 'badge-status--done' if employee.orientation_completed else 'badge-status--pending' }}">
                                                        <i t-attf-class="bi {{ 'bi-check-circle' if employee.orientation_completed else 'bi-clock' }} me-1"></i>
                                                        <t t-if="employee.orientation_completed">Completed</t>
                                                        <t t-else="">Pending</t>
                                                    </span>
                                                </div>
                                            </div>
                                        </div>
                                        <a href="/my/intern/calendar" class="btn btn-secondary btn-sm px-3">
                                            <i class="bi bi-calendar3 me-1"></i>View Calendar
                                        </a>
                                    </div>

                                    <!-- Step 3 -->
                                    <div class="onboarding-step d-flex align-items-center justify-content-between">
                                        <div class="d-flex align-items-center gap-3">
                                            <div t-attf-class="step-icon {{ 'step-icon--done' if employee.odoo_access_granted else 'step-icon--pending' }}">
                                                <i t-attf-class="bi {{ 'bi-check-lg' if employee.odoo_access_granted else 'bi-person-gear' }}"></i>
                                            </div>
                                            <div>
                                                <div class="fw-semibold">Step 3 — Set up Odoo Access</div>
                                                <div class="mt-1">
                                                    <span t-attf-class="badge-status {{ 'badge-status--done' if employee.odoo_access_granted else 'badge-status--pending' }}">
                                                        <i t-attf-class="bi {{ 'bi-check-circle' if employee.odoo_access_granted else 'bi-clock' }} me-1"></i>
                                                        <t t-if="employee.odoo_access_granted">Completed</t>
                                                        <t t-else="">Pending</t>
                                                    </span>
                                                </div>
                                            </div>
                                        </div>
                                        <a href="/my/account" target="_blank" class="btn btn-secondary btn-sm px-3">
                                            <i class="bi bi-pencil-square me-1"></i>Edit Profile
                                        </a>
                                    </div>

                                    <!-- Step 4 -->
                                    <div class="onboarding-step d-flex align-items-center justify-content-between" style="border-bottom: none;">
                                        <div class="d-flex align-items-center gap-3">
                                            <div t-attf-class="step-icon {{ 'step-icon--done' if employee.first_task_assigned else 'step-icon--pending' }}">
                                                <i t-attf-class="bi {{ 'bi-check-lg' if employee.first_task_assigned else 'bi-kanban' }}"></i>
                                            </div>
                                            <div>
                                                <div class="fw-semibold">Step 4 — Complete First Assigned Task</div>
                                                <div class="mt-1">
                                                    <span t-attf-class="badge-status {{ 'badge-status--done' if employee.first_task_assigned else 'badge-status--pending' }}">
                                                        <i t-attf-class="bi {{ 'bi-check-circle' if employee.first_task_assigned else 'bi-clock' }} me-1"></i>
                                                        <t t-if="employee.first_task_assigned">Completed</t>
                                                        <t t-else="">Pending</t>
                                                    </span>
                                                </div>
                                            </div>
                                        </div>
                                        <a href="/my/tasks" target="_blank" class="btn btn-secondary btn-sm px-3">
                                            <i class="bi bi-list-task me-1"></i>View Tasks
                                        </a>
                                    </div>

                                    <!-- Save — uses card-footer from global.css -->
                                    <div class="card-footer">
                                        <button type="submit" class="btn btn-primary px-4">
                                            <i class="bi bi-floppy me-2"></i>Save Progress
                                        </button>
                                    </div>

                                </form>
                            </div>
                        </div>
                    </div>

                    <!-- RIGHT: Sidebar -->
                    <div class="col-lg-4">

                        <!-- Progress Card -->
                        <div class="card mb-4">
                            <div class="card-header d-flex align-items-center gap-2">
                                <i class="bi bi-bar-chart-line onboarding-icon-header"></i>
                                <span>Progress Summary</span>
                            </div>
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="small fw-semibold">Completion</span>
                                    <span class="fw-bold onboarding-progress-label">
                                        <t t-out="progress"/>%
                                    </span>
                                </div>
                                <div class="progress mb-3 onboarding-progress-bar-wrap">
                                    <div class="progress-bar onboarding-progress-bar"
                                         role="progressbar"
                                         t-attf-style="width: #{progress}%"
                                         t-att-aria-valuenow="progress"
                                         aria-valuemin="0"
                                         aria-valuemax="100">
                                    </div>
                                </div>
                                <p class="small mb-0 onboarding-subtitle">
                                    <strong><t t-out="progress // 25"/></strong> of 4 steps completed
                                </p>

                                <!-- Step indicators -->
                                <div class="mt-4 d-flex flex-column gap-2">
                                    <t t-foreach="[
                                        (employee.handbook_reviewed,    'Read Intern Handbook'),
                                        (employee.orientation_completed,'Attend Orientation'),
                                        (employee.odoo_access_granted,  'Set up Odoo Access'),
                                        (employee.first_task_assigned,  'Complete First Task'),
                                    ]" t-as="step">
                                        <div class="d-flex align-items-center gap-2 small">
                                            <i t-attf-class="bi {{ 'bi-check-circle-fill step-done' if step[0] else 'bi-circle step-pending' }}"></i>
                                            <span t-attf-class="{{ 'step-label--done' if step[0] else 'step-label--pending' }}">
                                                <t t-out="step[1]"/>
                                            </span>
                                        </div>
                                    </t>
                                </div>
                            </div>
                        </div>

                        <!-- Intern Details Card -->
                        <div class="card">
                            <div class="card-header d-flex align-items-center gap-2">
                                <i class="bi bi-person-badge onboarding-icon-header"></i>
                                <span>Intern Details</span>
                            </div>
                            <div class="card-body p-0">
                                <div class="intern-detail-row">
                                    <span class="detail-label"><i class="bi bi-person me-2"></i>Supervisor</span>
                                    <span class="detail-value">
                                        <t t-out="employee.parent_id.name if employee.parent_id else 'Not Assigned'"/>
                                    </span>
                                </div>
                                <div class="intern-detail-row">
                                    <span class="detail-label"><i class="bi bi-building me-2"></i>Department</span>
                                    <span class="detail-value">
                                        <t t-out="employee.department_id.name if employee.department_id else 'Not Assigned'"/>
                                    </span>
                                </div>
                                <div class="intern-detail-row">
                                    <span class="detail-label"><i class="bi bi-clock-history me-2"></i>Hours</span>
                                    <span class="detail-value">
                                        <t t-out="'%.2f' % (employee.hours_rendered or 0)"/> /
                                        <t t-out="'%.2f' % (employee.contracted_hours or 0)"/> hrs
                                    </span>
                                </div>
                                <div class="intern-detail-row intern-detail-row--last">
                                    <span class="detail-label"><i class="bi bi-star me-2"></i>Avg Score</span>
                                    <span class="detail-value detail-value--highlight">
                                        <t t-out="'%.2f' % (employee.average_score or 0)"/> / 5.0
                                    </span>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </template>
</odoo>