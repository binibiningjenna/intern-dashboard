<odoo>
    <template id="intern_onboarding_page" name="Intern Onboarding">
        <t t-call="famtech_intern_dashboard.intern_navbar"/>
        <head>
            <title>Intern Onboarding</title>
            <meta charset="utf-8"/>
            <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
            <link rel="preconnect" href="https://fonts.googleapis.com"/>
            <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="crossorigin"/>
            <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&amp;display=swap" rel="stylesheet"/>
            <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet"/>
            <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"/>
            <link href="/famtech_intern_dashboard/static/src/website/css/global.css" rel="stylesheet"/>
            <link href="/famtech_intern_dashboard/static/src/website/css/onboarding.css" rel="stylesheet"/>
            <link href="https://cdn.jsdelivr.net/npm/aos@2.3.4/dist/aos.css" rel="stylesheet"/>
            <style>
                .reward-confetti-layer {
                    position: absolute;
                    inset: 0;
                    pointer-events: none;
                    overflow: hidden;
                    border-radius: inherit;
                    z-index: 5;
                }

                .reward-confetti-piece {
                    position: absolute;
                    top: -14px;
                    width: 8px;
                    height: 14px;
                    opacity: 0;
                    animation: rewardConfettiFall 1.8s ease-out forwards;
                }

                @keyframes rewardConfettiFall {
                    0% {
                        transform: translate3d(0, 0, 0) rotate(0deg);
                        opacity: 1;
                    }
                    100% {
                        transform: translate3d(var(--confetti-drift), 430px, 0) rotate(var(--confetti-rotate));
                        opacity: 0;
                    }
                }
            </style>
        </head>

        <div class="w-100 main-bg" style="min-height: 100vh; font-family: 'Poppins', sans-serif;">
            <div class="container py-5">
                <div class="d-flex flex-column" data-aos="fade-down" data-aos-duration="700">
                   <h4 class="text-start" style="text-transform: uppercase">
                        Welcome,
                        <span style="color: var(--color-gold-500);">
                            <t t-out="employee.name and employee.name.split(' ')[0] or 'Intern'"/>!
                        </span>
                    </h4>
                    <p class="text-muted mb-0" style="font-size: 0.9rem;">
                        Complete your onboarding steps to get everything set up and ready.
                    </p>
                </div>
                
                <hr class="brand-divider mb-4" data-aos="fade-in" data-aos-duration="1000" data-aos-delay="200" />
                
               <t t-if="progress == 100 and not employee.onboarding_modal_seen">
                    <div class="modal fade" id="completionModal" tabindex="-1">
                        <div class="modal-dialog modal-dialog-centered">
                            <div class="modal-content border-0 shadow-sm rounded-4 overflow-hidden position-relative">
                                <div class="reward-confetti-layer" aria-hidden="true"></div>

                                <!-- Header -->
                                <div class="modal-header border-0 justify-content-center position-relative py-3"
                                    style="background-color: var(--color-navy-100);">
                                    <h6 class="modal-title fw-bold text-center w-100 m-0"
                                        style="color: var(--color-navy-700); letter-spacing: 0.4px;">
                                        ONBOARDING COMPLETE
                                    </h6>
                                    <button type="button"
                                            class="btn-close position-absolute end-0 me-3"
                                            data-bs-dismiss="modal"></button>
                                </div>

                                <!-- Body -->
                                <div class="modal-body text-center py-4">
                                    <div class="mb-3">
                                        <i class="bi bi-patch-check-fill"
                                        style="color: var(--color-navy-500); font-size: 3.2rem;"></i>
                                    </div>
                                    <h6 class="fw-semibold mb-2"
                                        style="color: var(--color-navy-700);">
                                        Great work,
                                        <t t-out="employee.name and employee.name.split(' ')[0] or 'Intern'"/>!
                                    </h6>
                                    <p class="small mb-0 px-2"
                                    style="color: var(--color-gray-500); line-height: 1.5;">
                                        You’ve completed all onboarding steps.
                                    </p>
                                </div>

                                <!-- Footer -->
                                <div class="modal-footer border-0 justify-content-center pb-4 pt-0">
                                    <a href="/dashboard" class="btn btn-primary" id="goDashboardBtn">
                                        <i class="bi bi-speedometer2 me-2"></i>
                                        Go to Dashboard
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </t>

                <div class="row g-4">

                    <!-- Onboarding Steps -->
                    <div class="col-lg-8">
                        <div class="card border-0 shadow-sm dashboard-card" data-aos="fade-up" data-aos-duration="1000" data-aos-delay="150">
                            <div class="dashboard-header">
                                <div class="dashboard-title">
                                    <span class="dashboard-icon">
                                        <i class="bi bi-list-check"></i>
                                    </span>
                                    <span>Complete Your Onboarding Steps</span>
                                </div>
                            </div>
                            <div class="card-body p-0">
                                <form action="/onboarding/update" method="POST">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                                    <div class="onboarding-step d-flex flex-column flex-md-row align-items-start align-items-md-center justify-content-between gap-3 px-3 py-4">
                                        <div class="d-flex align-items-center gap-3">
                                            <div t-attf-class="step-icon {{ 'step-icon--done' if employee.handbook_reviewed else 'step-icon--pending' }}">
                                                <i t-attf-class="bi {{ 'bi-check-lg' if employee.handbook_reviewed else 'bi-book' }}"></i>
                                            </div>
                                            <div>
                                                <div class="fw-semibold">Step 1 — Read Intern Handbook</div>
                                                <div class="mt-1">
                                                    <span t-attf-class="badge rounded-2 px-1 px-sm-2 py-1 border {{ 'bg-primary-subtle text-primary-emphasis border-primary-subtle' if employee.handbook_reviewed else 'bg-warning-subtle text-dark border-warning-subtle' }}">
                                                        <t t-if="employee.handbook_reviewed">Completed</t>
                                                        <t t-else="">Pending</t>
                                                    </span>
                                                </div>
                                            </div>
                                        </div>
                                        <a href="/my/intern/handbook/download" target="_blank" class="btn btn-secondary ms-md-0" style="margin-left: 64px;">
                                            <i class="bi bi-file-earmark-text me-2"></i>Intern Handbook
                                        </a>
                                    </div>

                                    <div class="onboarding-step d-flex flex-column flex-md-row align-items-start align-items-md-center justify-content-between gap-3 px-3 py-4">
                                        <div class="d-flex align-items-center gap-3">
                                            <div t-attf-class="step-icon {{ 'step-icon--done' if employee.orientation_completed else 'step-icon--pending' }}">
                                                <i t-attf-class="bi {{ 'bi-check-lg' if employee.orientation_completed else 'bi-camera-video' }}"></i>
                                            </div>
                                            <div>
                                                <div class="fw-semibold">Step 2 — Attend Orientation Session</div>
                                                <div class="mt-1">
                                                    <span t-attf-class="badge rounded-2 px-1 px-sm-2 py-1 border {{ 'bg-primary-subtle text-primary-emphasis border-primary-subtle' if employee.orientation_completed else 'bg-warning-subtle text-dark border-warning-subtle' }}">
                                                        <t t-if="employee.orientation_completed">Completed</t>
                                                        <t t-else="">Pending</t>
                                                    </span>
                                                </div>
                                            </div>
                                        </div>
                                        <a href="/my/intern/calendar" class="btn btn-secondary ms-md-0" style="margin-left: 64px;">
                                            <i class="bi bi-calendar3 me-2"></i>View Calendar
                                        </a>
                                    </div>

                                    <div class="onboarding-step d-flex flex-column flex-md-row align-items-start align-items-md-center justify-content-between gap-3 px-3 py-4">
                                        <div class="d-flex align-items-center gap-3">
                                            <div t-attf-class="step-icon {{ 'step-icon--done' if employee.odoo_access_granted else 'step-icon--pending' }}">
                                                <i t-attf-class="bi {{ 'bi-check-lg' if employee.odoo_access_granted else 'bi-person-gear' }}"></i>
                                            </div>
                                            <div>
                                                <div class="fw-semibold">Step 3 — Set up Odoo Access</div>
                                                <div class="mt-1">
                                                    <span t-attf-class="badge rounded-2 px-1 px-sm-2 py-1 border {{ 'bg-primary-subtle text-primary-emphasis border-primary-subtle' if employee.odoo_access_granted else 'bg-warning-subtle text-dark border-warning-subtle' }}">
                                                        <t t-if="employee.odoo_access_granted">Completed</t>
                                                        <t t-else="">Pending</t>
                                                    </span>
                                                </div>
                                            </div>
                                        </div>
                                        <a href="/my/account" target="_blank" class="btn btn-secondary ms-md-0" style="margin-left: 64px;">
                                            <i class="bi bi-pencil-square me-2"></i>Edit Profile
                                        </a>
                                    </div>

                                    <div class="onboarding-step d-flex flex-column flex-md-row align-items-start align-items-md-center justify-content-between gap-3 px-3 py-4">
                                        <div class="d-flex align-items-center gap-3">
                                            <div t-attf-class="step-icon {{ 'step-icon--done' if employee.first_task_assigned else 'step-icon--pending' }}">
                                                <i t-attf-class="bi {{ 'bi-check-lg' if employee.first_task_assigned else 'bi-kanban' }}"></i>
                                            </div>
                                            <div>
                                                <div class="fw-semibold">Step 4 — Complete First Assigned Task</div>
                                                <div class="mt-1">
                                                    <span t-attf-class="badge rounded-2 px-1 px-sm-2 py-1 border {{ 'bg-primary-subtle text-primary-emphasis border-primary-subtle' if employee.first_task_assigned else 'bg-warning-subtle text-dark border-warning-subtle' }}">
                                                        <t t-if="employee.first_task_assigned">Completed</t>
                                                        <t t-else="">Pending</t>
                                                    </span>
                                                </div>
                                            </div>
                                        </div>
                                        <a href="/my/tasks" target="_blank" class="btn btn-secondary ms-md-0" style="margin-left: 64px;">
                                            <i class="bi bi-list-task me-2"></i>View Tasks
                                        </a>
                                    </div>

                                    <div class="bg-white border-top-0 px-3 py-4 d-flex justify-content-end align-items-center">
                                        <t t-if="progress == 100">
                                            <button type="submit" class="btn btn-secondary" disabled="disabled" aria-disabled="true" title="All onboarding steps are already completed.">
                                                <i class="bi bi-check-circle me-2"></i>Onboarding Complete
                                            </button>
                                        </t>
                                        <t t-else="">
                                            <button type="submit" class="btn btn-primary">
                                                <i class="bi bi-floppy me-2"></i>Save Progress
                                            </button>
                                        </t>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>

                    <!-- Onboarding Information -->
                    <div class="col-lg-4 d-flex flex-column">
                        <div class="card border-0 shadow-sm dashboard-card flex-fill d-flex flex-column" 
                            style="border-radius: 12px; overflow: hidden;"
                            data-aos="fade-up" data-aos-duration="1000" data-aos-delay="150">
                            <div class="dashboard-header">
                                <div class="dashboard-title">
                                    <span class="dashboard-icon">
                                        <i class="bi bi-person-badge"></i>
                                    </span>
                                    <span>Onboarding Information</span>
                                </div>
                            </div>

                            <div class="card-body d-flex flex-column p-0 flex-fill bg-white">

                                <div class="text-center pt-4 pb-2 px-4">
                                    <div class="mb-3">
                                        <t t-if="employee.image_1920">
                                            <img t-attf-src="/web/image/hr.employee/#{employee.id}/image_1920"
                                                class="rounded-circle shadow-sm border border-2 border-light"
                                                style="width: 85px; height: 85px; object-fit: cover;"/>
                                        </t>
                                        <t t-else="">
                                            <div class="rounded-circle d-flex align-items-center justify-content-center shadow-sm mx-auto"
                                                style="width: 85px; height: 85px; background: var(--color-navy-700); color: white; font-weight: 700; font-size: 2rem;">
                                                <t t-out="employee.name[:1].upper()"/>
                                            </div>
                                        </t>
                                    </div>

                                    <h5 class="fw-bold mb-1" style="color: var(--color-navy-500);">
                                        <t t-out="employee.name"/>
                                    </h5>
                                    <div class="text-muted mb-3" style="font-size: 0.9rem;">
                                        <t t-out="employee.work_email or 'No email provided'"/>
                                    </div>

                                    <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill"
                                        style="background: var(--color-gold-100); border: 1px solid var(--color-gold-200);">
                                        <span class="fw-bold" style="color: var(--color-gold-800); font-size: 0.7rem;">INTERN</span>
                                        <span class="text-muted" style="font-size: 0.75rem;">|</span>
                                        <span class="fw-semibold text-dark" style="font-size: 0.75rem;">
                                            ID: 000<t t-out="employee.id"/>
                                        </span>
                                    </div>
                                </div>

                                <div class="px-4 py-3 d-flex flex-column flex-fill justify-content-around">
                                    
                                    <div class="row g-2">
                                        <div class="col-6">
                                            <div class="text-uppercase fw-bold text-muted" style="font-size: 0.65rem; letter-spacing: 0.5px;">Phone</div>
                                            <div class="fw-semibold text-dark" style="font-size: 0.95rem;">
                                                <t t-out="employee.mobile_phone or 'Not Set'"/>
                                            </div>
                                        </div>
                                        <div class="col-6">
                                            <div class="text-uppercase fw-bold text-muted" style="font-size: 0.65rem; letter-spacing: 0.5px;">Birthday</div>
                                            <div class="fw-semibold text-dark" style="font-size: 0.95rem;">
                                                <t t-if="employee.birthday">
                                                    <t t-out="employee.birthday.strftime('%B %d, %Y')"/>
                                                </t>
                                                <t t-else="">Not Set</t>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="mt-2">
                                        <div class="text-uppercase fw-bold text-muted" style="font-size: 0.65rem; letter-spacing: 0.5px;">Job Position</div>
                                        <div class="fw-semibold text-dark" style="font-size: 0.95rem;">
                                            <t t-out="employee.job_id.name or 'Intern Trainee'"/>
                                        </div>
                                    </div>

                                    <div class="mt-2">
                                        <div class="text-uppercase fw-bold text-muted" style="font-size: 0.65rem; letter-spacing: 0.5px;">Department</div>
                                        <div class="fw-semibold text-dark" style="font-size: 0.95rem;">
                                            <t t-out="employee.department_id.name or 'Not Assigned'"/>
                                        </div>
                                    </div>

                                    <div class="mt-2">
                                        <div class="text-uppercase fw-bold text-muted" style="font-size: 0.65rem; letter-spacing: 0.5px;">Supervisor</div>
                                        <div class="fw-semibold text-dark" style="font-size: 0.95rem;">
                                            <t t-out="employee.parent_id.name or 'HR Manager'"/>
                                        </div>
                                    </div>

                                </div>

                                <div class="mt-auto py-2 bg-light text-center border-top">
                                    <span class="text-muted fw-light" style="font-size: 0.7rem;">
                                        Official Employee Record
                                    </span>
                                </div>

                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <script src="https://cdn.jsdelivr.net/npm/aos@2.3.4/dist/aos.js"></script>
        <script><![CDATA[
            document.addEventListener("DOMContentLoaded", function () {
                const modalEl = document.getElementById("completionModal");
                const completionSound = new Audio('/famtech_intern_dashboard/static/src/website/audio/Success_Sound-Effect.mp3');
                const confettiColors = ['#FFD285', '#bf9e3c', '#0e4174', '#709ECB', '#FFF2D1'];

                if (!modalEl) return;

                completionSound.preload = 'auto';

                function launchRewardConfetti(modalElement) {
                    const confettiLayer = modalElement.querySelector('.reward-confetti-layer');
                    if (!confettiLayer) return;

                    confettiLayer.innerHTML = '';

                    function createBurst() {
                        for (let i = 0; i < 40; i++) {
                            const piece = document.createElement('span');
                            const color = confettiColors[i % confettiColors.length];

                            const left = Math.random() * 100;
                            const delay = Math.random() * 0.3;
                            const drift = (Math.random() * 300) - 150;
                            const rotate = (Math.random() * 720) - 360;
                            const size = Math.random() * 8 + 6;

                            piece.className = 'reward-confetti-piece';
                            piece.style.left = left + '%';
                            piece.style.backgroundColor = color;
                            piece.style.animationDelay = delay + 's';
                            piece.style.setProperty('--confetti-drift', drift + 'px');
                            piece.style.setProperty('--confetti-rotate', rotate + 'deg');
                            piece.style.width = size + 'px';
                            piece.style.height = size + 'px';

                            if (Math.random() > 0.6) {
                                piece.style.borderRadius = '50%';
                            }

                            confettiLayer.appendChild(piece);
                        }
                    }

                    createBurst();
                    setTimeout(createBurst, 300);
                    setTimeout(createBurst, 600);

                    setTimeout(function () {
                        confettiLayer.innerHTML = '';
                    }, 3500);
                }

                const modal = new bootstrap.Modal(modalEl);
                modalEl.addEventListener('shown.bs.modal', function () {
                    launchRewardConfetti(modalEl);
                    completionSound.currentTime = 0;
                    completionSound.play().catch(function () {
                        // Ignore blocked autoplay errors; modal still appears.
                    });
                });
                modal.show();

                function markSeen() {
                    fetch('/onboarding/mark_seen', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify({})
                    });
                }

                modalEl.addEventListener('hidden.bs.modal', markSeen);

                const btn = document.getElementById("goDashboardBtn");
                if (btn) {
                    btn.addEventListener("click", markSeen);
                }
            });
            window.addEventListener("load", function () {
                AOS.init({
                    duration: 400,
                    once: true,
                    easing: 'ease-out-quad'
                });
            });
        ]]></script>
    </template>
</odoo>
