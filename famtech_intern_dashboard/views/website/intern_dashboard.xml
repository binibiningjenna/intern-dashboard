<odoo>
    <template id="intern_dashboard" name="Intern Dashboard">
        <t t-call="famtech_intern_dashboard.intern_navbar"/>
        <head>
            <title>Intern Dashboard</title>
            <meta charset="utf-8"/>
            <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
            <link rel="preconnect" href="https://fonts.googleapis.com"/>
            <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="crossorigin"/>
            <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&amp;display=swap" rel="stylesheet"/>
            <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet"/>
            <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"/>
            <link href="/famtech_intern_dashboard/static/src/website/css/global.css" rel="stylesheet"/>
            <link href="/famtech_intern_dashboard/static/src/website/css/dashboard.css" rel="stylesheet"/>
            <link href="https://cdn.jsdelivr.net/npm/aos@2.3.4/dist/aos.css" rel="stylesheet"/>
        </head>
        <body>
            <div class="w-100 intern-dashboard-page main-bg" style="min-height: 100vh; font-family: 'Poppins', sans-serif;" t-att-data-kpi="kpi_payload_json">
                <div class="container py-5">
                   <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center mb-2"
                        data-aos="fade-down"
                        data-aos-duration="700">
                        <div>
                            <h4 class="mb-1 fw-bold" style="text-transform: uppercase;">
                                Performance Metrics
                            </h4>
                            <p class="text-muted mb-0" style="font-size: 0.9rem;">
                                Real-time breakdown of your internship performance, progress, and evaluation scores.
                            </p>
                        </div>
                        <a href="/dashboard/kpi_export"
                        class="btn btn-primary d-flex align-items-center gap-2 mt-2 md-mt-0">
                            <i class="bi bi-download me-2"></i>
                            Export Report
                        </a>
                    </div>
                    <hr class="brand-divider mb-4" data-aos="fade-in" data-aos-duration="1000" data-aos-delay="200"/>
                    <div class="row g-3">
                        <div t-foreach="metrics" t-as="metric"
                            class="col-12 col-sm-6 col-lg-4 col-xl-3"
                            data-aos="fade-up"
                            data-aos-duration="600"
                            t-attf-data-aos-delay="{{ 50 + (metric_index * 100) }}">
                            <div class="metrics-card h-100 border-0 border-start border-4 shadow-sm" style="border-left-color: var(--color-navy-500) !important">
                                <div class="card-body p-3">
                                    <div class="d-flex align-items-center">
                                        <div class="rounded-3 d-flex align-items-center justify-content-center me-2 me-sm-3 flex-shrink-0" 
                                             style="background-color: var(--color-navy-100); color: var(--color-navy-700); width: 50px; height: 50px; font-size: 1.4rem">
                                            <i t-attf-class="bi bi-{{metric['icon']}}"></i>
                                        </div>
                                        <div class="flex-grow-1 min-w-0">
                                            <div class="d-flex justify-content-between align-items-center mb-1">
                                                <div class="text-uppercase text-muted fw-bold text-truncate pe-1" 
                                                     style="font-size: 0.70rem; letter-spacing: 0.5px">
                                                    <t t-esc="metric['label']"/>
                                                </div>
                                                 <span t-attf-class="badge rounded-2 px-1 px-sm-2 py-1 border #{'bg-primary-subtle text-primary-emphasis border-primary-subtle' if metric['result'] == 'success' else 'bg-warning-subtle text-dark border-warning-subtle'}"
                                                      style="font-size: 0.7rem;">
                                                    <t t-esc="'Passed' if metric['result'] == 'success' else 'Failed'"/>
                                                </span>
                                            </div>
                                            <h3 class="fw-bolder mb-0 lh-1" style="color: var(--color-navy-500); font-size: 1.75rem;">
                                                <t t-esc="metric['value']"/>
                                            </h3>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row g-3 mt-2">
                        <div class="col-12 col-lg-6"
                            data-aos="fade-up"
                            data-aos-duration="1000"
                            data-aos-delay="600">
                            <div class="card h-100 border-0 shadow-sm dashboard-card">
                                <div class="dashboard-header">
                                    <div class="dashboard-title">
                                        <span class="dashboard-icon">
                                            <i class="bi bi-bar-chart-line"></i>
                                        </span>
                                        <span>Average Score</span>
                                    </div>
                                </div>
                                <div class="card-body dashboard-progress-card__body">
                                    <div class="dashboard-chart-frame dashboard-chart-frame-compact">
                                        <div id="averageScoreProgress" class="dashboard-score-progress"></div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-12 col-lg-6"
                            data-aos="fade-up"
                            data-aos-duration="1000"
                            data-aos-delay="600">
                            <div class="card h-100 border-0 shadow-sm dashboard-card">
                                <div class="dashboard-header">
                                    <div class="dashboard-title">
                                        <span class="dashboard-icon">
                                            <i class="bi bi-clock-history"></i>
                                        </span>
                                        <span>Contract Hours vs Rendered Hours</span>
                                    </div>
                                </div>
                                <div class="card-body dashboard-progress-card__body">
                                    <div class="dashboard-chart-frame dashboard-chart-frame-compact">
                                        <div id="hoursProgressChart" class="dashboard-hours-progress"></div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-12 mt-4"
                            data-aos="fade-up"
                            data-aos-duration="1000">
                            <div class="card h-100 border-0 shadow-sm dashboard-card">
                                <div class="dashboard-header">
                                    <div class="dashboard-title">
                                        <span class="dashboard-icon">
                                            <i class="bi bi-graph-up-arrow"></i>
                                        </span>
                                        <span>Timeliness vs Responsiveness</span>
                                    </div>
                                </div>
                                <div class="card-body dashboard-progress-card__body">
                                    <div class="dashboard-chart-frame dashboard-chart-frame-lg">
                                        <div id="timelinessResponsivenessEmptyState" 
                                            class="dashboard-empty-state d-flex flex-column align-items-center justify-content-center text-center py-5 bg-light rounded-4 border border-dashed mt-2"
                                            style="display: none;"> <i class="bi bi-bar-chart text-muted mb-2" style="font-size: 2rem; opacity: 0.5;"></i>                                      
                                            <div class="text-uppercase fw-bold text-muted mb-1" 
                                                style="font-size: 0.65rem; letter-spacing: 0.5px;">
                                                Analytics Status
                                            </div>
                                            <p class="text-muted small mb-0">No performance data available yet.</p>
                                        </div>
                                        <canvas id="timelinessResponsivenessChart"></canvas>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
            <script src="https://cdn.jsdelivr.net/npm/aos@2.3.4/dist/aos.js"></script>
            <script src="/famtech_intern_dashboard/static/src/website/js/dashboard.js"></script>
        </body>
    </template>
</odoo>
