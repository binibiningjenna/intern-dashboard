<odoo>
    <template id="intern_dashboard" name="Intern Dashboard">
        <t t-call="famtech_intern_dashboard.intern_navbar"/>
        <head>
            <title>Intern Dashboard</title>
            <meta charset="utf-8"/>
            <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
            <link rel="preconnect" href="https://fonts.googleapis.com"/>
            <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="crossorigin"/>
            <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&amp;display=swap" rel="stylesheet"/>
            <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet"/>
            <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"/>
            <link href="/famtech_intern_dashboard/static/src/website/css/global.css" rel="stylesheet"/>
        </head>
        <body>
            <div class="w-100" style="background:linear-gradient(135deg, #f5f7fa 0%, #e4e8f0 100%); min-height: 100vh; font-family: 'Poppins', sans-serif;">
                <div class="container py-5">
                    
                    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-center">
                        <h4 class="mb-3 mb-sm-0 text-center text-sm-start" style="text-transform: uppercase">Performance Metrics</h4>
                        <button class="btn btn-primary"><i class="bi bi-download me-2"></i> Export Report</button>
                    </div>
                    
                    <hr class="brand-divider mb-4" />

                    <div class="row g-3">
                        <div t-foreach="metrics" t-as="metric" class="col-12 col-sm-6 col-lg-4 col-xl-3">
                            <div class="card h-100 border-0 border-start border-4 shadow-sm" style="border-left-color: var(--color-navy-500) !important">
                                <div class="card-body p-3">
                                    <div class="d-flex align-items-center">
                                        <div class="rounded-3 d-flex align-items-center justify-content-center me-2 me-sm-3 flex-shrink-0" 
                                             style="background-color: var(--color-navy-100); color: var(--color-navy-700); width: 50px; height: 50px; font-size: 1.4rem">
                                            <i t-attf-class="bi bi-{{metric['icon']}}"></i>
                                        </div>
                                        <div class="flex-grow-1 min-w-0">
                                            <div class="d-flex justify-content-between align-items-center mb-1">
                                                <div class="text-uppercase text-muted fw-bold text-truncate pe-1" 
                                                     style="font-size: 0.70rem; letter-spacing: 0.5px">
                                                    <t t-esc="metric['label']"/>
                                                </div>
                                                <span class="badge bg-success-subtle text-success border border-success-subtle rounded-2 px-1 px-sm-2 py-1" 
                                                      style="font-size: 0.7rem;">Success</span>
                                            </div>
                                            <h3 class="fw-bolder mb-0 lh-1" style="color: var(--color-navy-500); font-size: 1.75rem;">
                                                <t t-esc="metric['value']"/>
                                            </h3>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </body>
    </template>
</odoo>