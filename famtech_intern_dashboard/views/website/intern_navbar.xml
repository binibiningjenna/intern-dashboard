<odoo>
    <template id="intern_navbar" name="Intern Navbar">
        <link rel="preconnect" href="https://fonts.googleapis.com"/>
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="crossorigin"/>
        <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&amp;display=swap" rel="stylesheet"/>
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet"/>
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"/>
        
        <nav class="navbar navbar-expand-lg py-2 custom-navbar shadow-sm sticky-top">
            <div class="container-fluid px-3 px-lg-5">
                
                <a class="navbar-brand d-flex align-items-center" href="/my/intern_dashboard">
                    <img src="/famtech_intern_dashboard/static/src/website/img/famtech_logo_no_bg.png"
                         alt="FAMTECH Logo"
                         height="50"
                         class="brand-logo"/>
                </a>

                <button class="navbar-toggler border-0 text-white"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#internNavbarMenu"
                        aria-controls="internNavbarMenu"
                        aria-expanded="false"
                        aria-label="Toggle navigation">
                    <i class="bi bi-list fs-1 text-white"></i>
                </button>

                <div class="collapse navbar-collapse" id="internNavbarMenu">
                    <ul class="navbar-nav ms-auto align-items-start align-items-lg-center gap-2 gap-lg-4 mt-3 mt-lg-0">
                        
                        <li class="nav-item w-100 w-lg-auto">
                            <a t-attf-class="nav-link nav-link-custom d-flex align-items-center gap-2 #{'active' if page_name == 'intern_dashboard' else ''}"
                               href="/my/intern_dashboard">
                                <i class="bi bi-house-door"></i>
                                <span class="fw-bold text-uppercase">Dashboard</span>
                            </a>
                        </li>

                        <li class="nav-item w-100 w-lg-auto">
                            <a t-attf-class="nav-link nav-link-custom d-flex align-items-center gap-2 #{'active' if page_name == 'intern_onboarding' else ''}"
                               href="/my/intern/onboarding">
                                <i class="bi bi-clipboard-check"></i>
                                <span class="fw-bold text-uppercase">Onboarding</span>
                            </a>
                        </li>

                        <li class="nav-item w-100 w-lg-auto">
                            <a t-attf-class="nav-link nav-link-custom d-flex align-items-center gap-2 #{'active' if page_name == 'intern_rewards' else ''}"
                               href="/my/intern/rewards">
                                <i class="bi bi-trophy"></i>
                                <span class="fw-bold text-uppercase">Rewards</span>
                            </a>
                        </li>

                        <li class="nav-item w-100 w-lg-auto ms-lg-2">
                            <a class="nav-link logout-btn d-flex align-items-center gap-2 px-3" 
                               href="/web/session/logout?redirect=/web/login">
                                <i class="bi bi-box-arrow-right fs-5"></i>
                                <span class="fw-bold text-uppercase">Logout</span>
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

        <style>
            .navbar-toggler,
            .navbar-toggler:focus,
            .navbar-toggler:active,
            .navbar-toggler-icon:focus {
                outline: none !important;
                box-shadow: none !important;
                border: none !important;
            }
            
            .custom-navbar {
                background: linear-gradient(90deg, var(--color-navy-900) 0%, var(--color-navy-500) 100%);
                font-family: 'Poppins', sans-serif;
                z-index: 1030;
            }

            .nav-link-custom, .logout-btn {
                color: var(--color-white) !important;
                font-size: 0.85rem;
                letter-spacing: 0.5px;
                padding: 0.5rem 0.75rem !important;
                transition: all 0.3s ease;
                opacity: 0.9;
                border-radius: 6px;
                text-decoration: none;
            }

            .nav-link-custom:hover {
                color: var(--color-gold-300) !important;
                background: rgba(255, 255, 255, 0.05);
                opacity: 1;
            }

            .nav-link-custom.active {
                color: var(--color-gold-300) !important;
                background: rgba(255, 255, 255, 0.1) !important;
                opacity: 1;
            }

            .logout-btn:hover {
                color: #FF6B6B !important; 
                background: rgba(255, 77, 77, 0.15); 
                opacity: 1;
                box-shadow: inset 0 0 5px rgba(255, 77, 77, 0.2);
            }

            @media (max-width: 991.98px) {
                .navbar-collapse {
                    background: var(--color-navy-900);
                    margin: 0 -1rem;
                    padding: 1.5rem;
                    border-top: 1px solid rgba(255,255,255,0.1);
                }
                .nav-link-custom, .logout-btn {
                    padding: 0.8rem 1rem !important;
                    width: 100%;
                }

                .nav-link-custom.active {
                    border-left: 3px solid var(--color-gold-500);
                    border-radius: 0 6px 6px 0;
                }
            }
        </style>
    </template>
</odoo>