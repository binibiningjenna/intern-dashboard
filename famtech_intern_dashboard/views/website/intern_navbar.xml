<odoo>
    <template id="intern_navbar" name="Intern Navbar">
        <nav class="navbar navbar-expand-lg intern-navbar">
            <div class="container-fluid px-3 px-lg-4">

                <a class="navbar-brand d-flex align-items-center" href="/my/intern_dashboard">
                    <img src="/famtech_intern_dashboard/static/src/img/famtech_logo_no_bg.png"
                         alt="FAMTECH Logo"
                         class="intern-navbar-logo"/>
                </a>

                <button class="navbar-toggler border-0 shadow-none"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#internNavbarMenu"
                        aria-controls="internNavbarMenu"
                        aria-expanded="false"
                        aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="internNavbarMenu">
                    <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-3">

                        <li class="nav-item">
                            <a t-attf-class="nav-link #{'active' if page_name == 'intern_dashboard' else ''}"
                               href="/my/intern_dashboard">
                                <i class="bi bi-house-door me-2"></i>
                                <span>Intern Dashboard</span>
                            </a>
                        </li>

                        <li class="nav-item">
                            <a t-attf-class="nav-link #{'active' if page_name == 'intern_onboarding' else ''}"
                               href="/my/intern/onboarding">
                                <i class="bi bi-clipboard-check me-2"></i>
                                <span>Onboarding</span>
                            </a>
                        </li>

                        <li class="nav-item">
                            <a t-attf-class="nav-link #{'active' if page_name == 'intern_rewards' else ''}"
                               href="/my/intern/rewards">
                                <i class="bi bi-trophy me-2"></i>
                                <span>Rewards</span>
                            </a>
                        </li>

                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle d-flex align-items-center"
                               href="#"
                               id="internProfileDropdown"
                               role="button"
                               data-bs-toggle="dropdown"
                               aria-expanded="false">
                                <i class="bi bi-person-circle fs-4"></i>
                            </a>

                            <ul class="dropdown-menu dropdown-menu-end intern-profile-menu"
                                aria-labelledby="internProfileDropdown">
                                <li class="dropdown-item-text fw-semibold">
                                    <t t-esc="request.env.user.name"/>
                                </li>
                                <li><hr class="dropdown-divider"/></li>
                                <li>
                                    <a class="dropdown-item" href="/web/session/logout?redirect=/web/login">
                                        <i class="bi bi-box-arrow-right me-2"></i>Logout
                                    </a>
                                </li>
                            </ul>
                        </li>

                    </ul>
                </div>
            </div>
        </nav>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    </template>
</odoo>