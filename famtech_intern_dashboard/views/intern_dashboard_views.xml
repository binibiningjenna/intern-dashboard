<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_intern_dashboard_kanban" model="ir.ui.view">
        <field name="name">intern.dashboard.kanban</field>
        <field name="model">hr.employee</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_dashboard">
                <field name="name"/>
                <field name="hours_rendered"/>
                <field name="contracted_hours"/>
                <field name="average_score"/>
                <field name="punctuality_score"/>

                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click o_card p-3">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <strong class="text-truncate">
                                    <field name="name"/>
                                </strong>
                            </div>

                            <div class="mb-2">
                                <small class="text-muted">Hours Rendered</small>
                                <div class="fw-bold">
                                    <field name="hours_rendered"/> /
                                    <field name="contracted_hours"/>
                                </div>
                            </div>

                            <div class="progress mb-3" style="height: 8px;">
                                <div class="progress-bar"
                                    role="progressbar"
                                    t-att-style="'width: ' + (
                                        record.contracted_hours.value 
                                        ? (record.hours_rendered.value / record.contracted_hours.value * 100) 
                                        : 0
                                    ) + '%'">
                                </div>
                            </div>

                            <div class="d-flex justify-content-between align-items-center">
                                <small class="text-muted">Average Score</small>
                                <span class="fw-bold">
                                    <field name="average_score"/>
                                </span>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_employee_form_intern" model="ir.ui.view">
        <field name="name">hr.employee.form.intern</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">

            <xpath expr="//notebook/page[1]" position="inside">
                
                <!-- Intern Details -->
                <group string="Intern Details">
                    <field name="is_intern"/>
                    <field name="contracted_hours"/>
                    <field name="hours_rendered"/>
                    <field name="task_target_monthly" placeholder="e.g. 10" help="Enter the number of tasks expected per month (numeric value only)."/>
                    <field name="average_score"/>
                </group>

                <!-- Onboarding Checklist Details -->
                <group string="Onboarding Checklist">
                    <field name="handbook_reviewed"/>
                    <field name="orientation_completed"/>
                    <field name="odoo_access_granted"/>
                    <field name="first_task_assigned"/>
                </group>

                <!-- Performance Metrics -->
                <group string="Performance Metrics">
                    
                    <!-- Auto-computed Metrics -->
                    <group>
                        <field name="timeliness_score" readonly="1"/>
                        <field name="punctuality_score" readonly="1"/>
                        <field name="quantity_score" readonly="1"/>
                        <field name="quality_score" readonly="1"/>
                        <field name="effectiveness_score" readonly="1"/>
                        <field name="efficiency_score" readonly="1"/>
                        <field name="accuracy_score" readonly="1"/>
                    </group>
                    
                    <!-- Responsiveness (Manual Input) -->
                    <group string="Responsiveness" col="4">
                        <field name="responsiveness_viber" widget="float" string="Viber"/>
                        <field name="responsiveness_google_chat" widget="float" string="Google Chat"/>
                        <field name="responsiveness_gmail" widget="float" string="Gmail"/>
                        <field name="responsiveness_zoho_email" widget="float" string="Zoho"/>
                        <newline colspan="4"/>
                        <div class="o_row" colspan="4" style="margin-top: -5px; border-top: 1px solid #e0e0e0; padding-top: 5px;">
                            <strong>Responsiveness Score:</strong>
                            <field name="responsiveness_score" readonly="1" nolabel="1"/>
                        </div>
                    </group>
                    
                </group>

            </xpath>

        </field>
    </record>

    <record id="action_intern_dashboard" model="ir.actions.act_window">
        <field name="name">Intern Dashboard</field>
        <field name="res_model">hr.employee</field>
        <field name="view_mode">kanban,form</field>
        <field name="view_id" ref="view_intern_dashboard_kanban"/>
        <field name="domain">[('is_intern','=',True)]</field>
    </record>

    <menuitem id="menu_intern_dashboard_root"
              name="Intern Dashboard"
              parent="hr.menu_hr_root"
              action="action_intern_dashboard"/>
</odoo>